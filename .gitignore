# ── Private infrastructure ─────────────────────────────────────────────────
# The checker Worker, review console, management CLI, monitoring budgets and onboarding reviews live
# in a separate private repository. These guards stop any copy of them from being committed here.
checker-worker/
admin/
scripts/local/
scripts/catalog-admin.mjs
scripts/dev-catalog.mjs
catalog/monitoring.json
catalog/reviews/

# ── Internal documents ─────────────────────────────────────────────────────
# Planning, design, and implementation notes are kept out of the public repo.
CODING_REPORT.md
PLAN.md
INTERACTION_DESIGN.md
UI_DESIGN.md
PRODUCT_SPEC.md
design-system/

# ── Dependencies and build output ──────────────────────────────────────────
node_modules/
dist/
.astro/

# ── Cloudflare Wrangler ────────────────────────────────────────────────────
.wrangler/

# ── Environment variables ──────────────────────────────────────────────────
.env
.env.*
!.env.local.example
# Wrangler/Astro local secrets (astro build copies .dev.vars into dist/server/)
