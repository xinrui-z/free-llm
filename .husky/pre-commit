#!/bin/sh
# Only run validation if catalog data or its validators are staged.
# Matches: site/src/data/providers/*.json (per-provider files + _order.json)
#          site/src/data/changelog.json
#          catalog/** (sources, monitoring policies, sync state, reviews)
#          scripts/lib/** (shared validation library)
if git diff --cached --name-only | grep -qE '^(site/src/data/(providers/.*|changelog)\.json|catalog/|scripts/lib/)'; then
  node scripts/validate.mjs
fi
