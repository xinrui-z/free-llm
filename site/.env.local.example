# Copy this file to site/.env.local for local development (.env.local is gitignored).
#
# Only PUBLIC_STATUS_WORKER_URL belongs here. It is the origin of a deployed checker Worker and is used for:
#   - /api/status: live status in the browser-side status widgets;
#   - /api/changelog: the browser-side changelog refresh;
#   - the dynamic-mode catalog API: when CATALOG_MODE=dynamic and no CATALOG_API_URL is set, server
#     rendering falls back to this URL. So exporting only CATALOG_MODE=dynamic in your shell makes local
#     SSR read whatever Worker this file points at (e.g. production). Set CATALOG_API_URL explicitly.
# Leave it empty to disable live fetching: status then shows as unknown (there is no bundled status
# snapshot), and the changelog uses the repository's site/src/data/changelog.json.
PUBLIC_STATUS_WORKER_URL=https://free-llm-checker.YOUR_SUBDOMAIN.workers.dev

# The settings below are read by astro.config.mjs from the SHELL environment (process.env)
# when Astro starts, not from this file. Export them in your shell or CI instead:
#
#   CATALOG_MODE=dynamic        Server-render pages from the live catalog API (default: static,
#                               which builds from site/src/data/providers/*.json).
#   CATALOG_API_URL=https://... Catalog API origin used by dynamic mode (/api/catalog, /api/changelog).
#   CATALOG_CACHE_TTL_MS=...    Optional dynamic-mode catalog cache TTL in milliseconds.
#   PUBLIC_SITE_URL=https://... Canonical site URL for sitemap/links (default: the Pages domain).
#
# A PUBLIC_STATUS_WORKER_URL exported in the shell takes precedence over the value in this file.
#
# To preview dynamic mode against a catalog API, export CATALOG_MODE=dynamic and CATALOG_API_URL
# in the shell before running npm run dev.
