---
// /models answers "Where can I call model X for free, and with what limits?".
// One flat model x provider table, grouped by family: explicit families from MODEL_FAMILIES first, then
// vendor groups generated by classifyModels() for new models no family matches yet, and "Other models"
// only for IDs with neither an org prefix nor a known vendor token. Desktop renders a <table>; below 768px the same
// listings render as stacked rows. Both carry identical data-* hooks, so one script filters both.
// Without JS (or without the status API) the full grouped list is still rendered; filters only toggle `hidden`.
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import SearchInput from '../../components/SearchInput.astro';
import Chip from '../../components/Chip.astro';
import NotPublished from '../../components/NotPublished.astro';
import CopyButton from '../../components/CopyButton.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import StatusSlot from '../../components/StatusSlot.astro';
import { getProviders } from '../../lib/providers';
import { formatCount, formatTokens, limitsOf, NO_CONTEXT_NOTE } from '../../lib/format';
import { classifyModels, isListableModel, type ModelFamily } from '../../data/model-families';
import type { Provider, ProviderModel } from '../../data/providers';
import { sortModels } from '../../../../scripts/lib/catalog-validation.mjs';

const providers = getProviders(Astro.locals) as Provider[];
const activeProviders = providers.filter(p => p.status === 'active');

// Desktop folds only the "Other models" group; mobile also folds long families.
const OTHER_FOLD = 10;
const FAMILY_FOLD_SM = 5;

// classifyModels() owns which models are listable (no deprecated models, no safety classifiers like
// llama-prompt-guard) and which family each one lands in. A model claimed by several explicit families
// is listed once, under the first of them in MODEL_FAMILIES order.
const classified = classifyModels(activeProviders);
const familyByKey = new Map<string, ModelFamily>();
for (const { family, entries } of classified.families) {
  for (const { provider, models } of entries) {
    for (const m of models) if (!familyByKey.has(`${provider.id}:${m.id}`)) familyByKey.set(`${provider.id}:${m.id}`, family);
  }
}

type Cap = 'vision' | 'reasoning' | 'code';
interface Listing {
  key: string;
  m: ProviderModel;
  p: Provider;
  order: number;
  f: ModelFamily | null;
  caps: Cap[];
  rpm: number | null;
  rpd: number | null;
  pub: boolean;
}

const REASONING_ID = /(^|[-_.:])(reason(ing|er)?|thinking|z1|r1)([-_.:]|$)/i;
const listings: Listing[] = [];
activeProviders.forEach((p, order) => {
  // Each provider's models follow its own display order (model_order pins first, then upstream order).
  for (const m of sortModels(p.models, p.model_order) as ProviderModel[]) {
    if (!isListableModel(m)) continue;
    const f = familyByKey.get(`${p.id}:${m.id}`) ?? null;
    const tags = f?.tags ?? [];
    const mods = m.modalities ?? [];
    const caps: Cap[] = [];
    if (mods.includes('vision')) caps.push('vision');
    // Model part of the ID only (after the last '/'), as whole tokens: vendor names ("Thinking Machines")
    // and stray substrings ("-r100") must not make a model "reasoning".
    if (tags.includes('thinking') || REASONING_ID.test(m.id.split('/').pop() ?? '')) caps.push('reasoning');
    if (mods.includes('code') || tags.includes('code') || /cod(e|ing)|codestral/i.test(m.id)) caps.push('code');
    const L = limitsOf(m);
    listings.push({ key: `${p.id}:${m.id}`, m, p, order, f, caps, rpm: L.rpm, rpd: L.rpd, pub: L.published });
  }
});

const byLimits = (a: Listing, b: Listing) =>
  (b.rpd ?? -1) - (a.rpd ?? -1) || (b.rpm ?? -1) - (a.rpm ?? -1) || a.order - b.order;

interface Group { key: string; f: ModelFamily | null; rows: Listing[]; pub: boolean; maxRpd: number; nprov: number }
const byFamily = new Map<string, Group>();
const unmatched: Listing[] = [];
for (const x of listings) {
  if (!x.f) { unmatched.push(x); continue; }
  if (!byFamily.has(x.f.id)) byFamily.set(x.f.id, { key: x.f.id, f: x.f, rows: [], pub: false, maxRpd: -1, nprov: 0 });
  byFamily.get(x.f.id)!.rows.push(x);
}
const families = [...byFamily.values()].map(g => {
  g.rows.sort(byLimits); // stable: same-provider rows keep sortModels order
  g.pub = g.rows.some(x => x.pub);
  g.maxRpd = Math.max(-1, ...g.rows.map(x => x.rpd ?? -1));
  g.nprov = new Set(g.rows.map(x => x.p.id)).size;
  return g;
});
// Families with published limits first, highest daily limit on top; explicit families before the
// auto-generated vendor groups, which only collect models no explicit family matches yet.
const byPublished = (a: Group, b: Group) =>
  Number(b.pub) - Number(a.pub) || b.maxRpd - a.maxRpd || b.nprov - a.nprov || a.f!.name.localeCompare(b.f!.name);
const mainGroups = [
  ...families.filter(g => !g.f!.auto).sort(byPublished),
  ...families.filter(g => g.f!.auto).sort(byPublished),
];
const otherGroup: Group | null = unmatched.length
  ? { key: 'other', f: null, rows: unmatched, pub: unmatched.some(x => x.pub), maxRpd: -1, nprov: new Set(unmatched.map(x => x.p.id)).size }
  : null;
const groups: Group[] = otherGroup ? [...mainGroups, otherGroup] : mainGroups;

const total = listings.length;
const providerCount = new Set(listings.map(x => x.p.id)).size;
const listedProviders = activeProviders.filter(p => listings.some(x => x.p.id === p.id));
const capCount = (c: Cap) => listings.filter(x => x.caps.includes(c)).length;
const pubCount = listings.filter(x => x.pub).length;
const chips = [
  { name: 'vision', label: 'Vision', count: capCount('vision') },
  { name: 'reasoning', label: 'Reasoning', count: capCount('reasoning') },
  { name: 'code', label: 'Code', count: capCount('code') },
  { name: 'pub', label: 'Published RPM or RPD', count: pubCount },
];

const nprovText = (n: number) => ` · ${n} provider${n === 1 ? '' : 's'}`;
// Vendor is plain text; skip it when the family name already starts with it ("Mistral / Magistral …").
const vendorOf = (f: ModelFamily) => (f.category && !f.name.toLowerCase().startsWith(f.category.toLowerCase()) ? f.category : '');
const useHref = (x: Listing) => `/providers/${encodeURIComponent(x.p.id)}?model=${encodeURIComponent(x.m.id)}#quick-start`;
const rowAttrs = (x: Listing, g: Group) => ({
  'data-m-row': '',
  'data-key': x.key,
  'data-prov': x.p.id,
  'data-caps': x.caps.join(' '),
  'data-pub': String(x.pub),
  'data-search': [x.m.id, x.m.name, x.p.name, x.p.id, x.f?.name, x.f?.category].filter(Boolean).join(' ').toLowerCase(),
  'data-group': g.key,
});
// SSR the default (unfiltered) fold state; the client script keeps it in sync.
const foldOf = (g: Group, sm: boolean) => (g.key === 'other' ? OTHER_FOLD : sm ? FAMILY_FOLD_SM : 0);
const folded = (g: Group, sm: boolean) => { const n = foldOf(g, sm); return n > 0 && g.rows.length > n + 1 ? n : 0; };
const moreLabel = (g: Group, n: number) => `Show ${g.rows.length - n} more${g.f ? ` ${g.f.name}` : ''}`;
const limitTip = (x: Listing) => `${x.p.name} does not publish this limit.`;
const NCOL = 7;
// Vendor groups are generated for models that no named family matches yet.
const AUTO_NOTE = 'new models grouped by vendor';

const topFamilies = mainGroups.slice(0, 4).map(g => g.f!.name).join(', ');
---

<Layout
  title="Models — Free LLM APIs"
  description={`Find which of ${providerCount} free LLM API providers let you call ${topFamilies || 'open models'} and more for free, with the rate limits each provider documents.`}
>
  <PageHeader title="Models" lead="Find which providers let you call a model for free, and with what limits.">
    <Fragment slot="meta"><span class="num">{total}</span> model listings across <span class="num">{providerCount}</span> providers · archived providers excluded</Fragment>
  </PageHeader>
  <StatusNotice liveOnly />

  <div class="toolbar">
    <SearchInput id="m-q" label="Search models" placeholder="Model ID, family or provider" param="q" />
    <div class="chips" id="m-chips">
      {chips.map(c => (
        <Chip name={c.name} label={c.label} count={c.count} hidden={c.count === total ? true : undefined} />
      ))}
    </div>
    <label class="sr-only" for="m-prov">Provider</label>
    <select class="select" id="m-prov">
      <option value="">All providers</option>
      {listedProviders.map(p => <option value={p.id}>{p.name}</option>)}
    </select>
    <span class="count" id="m-count" aria-live="polite"></span>
  </div>
  <p class="caption m-caption">
    Families with published limits come first, highest daily limit on top. New models outside a known family
    are grouped by vendor after the named families. A dash means the provider does not publish that value;
    it never means unlimited.
  </p>

  <div class="empty" id="m-empty" hidden>
    <p id="m-empty-text">No model matches these filters. Try a family name like gemma, glm or qwen.</p>
    <button type="button" class="btn" id="m-clear">Clear filters</button>
  </div>

  <div id="m-results">
    <div class="only-md tblwrap">
      <table class="tbl m-tbl">
        <thead>
          <tr>
            <th scope="col">Model ID</th>
            <th scope="col">Provider</th>
            <th scope="col" class="r"><abbr title="Requests per day">RPD</abbr></th>
            <th scope="col" class="r"><abbr title="Requests per minute">RPM</abbr></th>
            <th scope="col" class="r">Context</th>
            <th scope="col">Capabilities</th>
            <th scope="col"><span class="sr-only">Use</span></th>
          </tr>
        </thead>
        {groups.map(g => {
          const fold = folded(g, false);
          return (
            <tbody data-m-group={g.key} data-fold={foldOf(g, false)}>
              <tr class="grp">
                <td colspan={NCOL}>
                  {g.f ? (
                    <>
                      {vendorOf(g.f) && <span class="m-gh-soft">{vendorOf(g.f)} · </span>}
                      <span class="m-gh-name">{g.f.name}</span>
                      {g.f.auto && <span class="m-gh-soft"> · {AUTO_NOTE}</span>}
                      <span class="m-gh-soft" data-m-nprov>{nprovText(g.nprov)}</span>
                    </>
                  ) : (
                    <>
                      <span class="m-gh-name">Other models</span>
                      <span class="m-gh-soft"> · no known family or vendor · <span data-m-n>{g.rows.length}</span></span>
                    </>
                  )}
                </td>
              </tr>
              {g.rows.map((x, i) => {
                const t = formatTokens(x.m.context_window);
                return (
                  <tr {...rowAttrs(x, g)} hidden={fold && i >= fold ? true : undefined}>
                    <td>
                      <div class="idcell"><span class="mono">{x.m.id}</span><CopyButton value={x.m.id} label="model ID" /></div>
                    </td>
                    <td>
                      <div class="pcell m-pcell">
                        <StatusSlot providerId={x.p.id} />
                        <ProviderLogo provider={x.p} size={16} />
                        <a class="lnk m-nowrap" href={`/providers/${x.p.id}`}>{x.p.name}</a>
                      </div>
                    </td>
                    <td class="r">{x.rpd != null ? <span class="num">{formatCount(x.rpd)}</span> : <NotPublished variant="dash" note={limitTip(x)} />}</td>
                    <td class="r">{x.rpm != null ? <span class="num">{formatCount(x.rpm)}</span> : <NotPublished variant="dash" note={limitTip(x)} />}</td>
                    <td class="r">{t ? <span class="num" title={t.title}>{t.text}</span> : <NotPublished variant="dash" note={NO_CONTEXT_NOTE} />}</td>
                    <td><span class="m-caps">{x.caps.map(c => <span class="tag tag-o">{c}</span>)}</span></td>
                    <td class="r"><a class="lnk m-nowrap" href={useHref(x)} aria-label={`Use ${x.m.id} from ${x.p.name} in Quick start`}>Use →</a></td>
                  </tr>
                );
              })}
              {fold > 0 && (
                <tr data-m-more-row>
                  <td colspan={NCOL}>
                    <button type="button" class="btn btn-sm" data-m-toggle={g.key} aria-expanded="false">{moreLabel(g, fold)}</button>
                  </td>
                </tr>
              )}
            </tbody>
          );
        })}
      </table>
    </div>

    <div class="only-sm m-list">
      {groups.map(g => {
        const fold = folded(g, true);
        return (
          <section class="m-grp" data-m-group={g.key} data-fold={foldOf(g, true)} aria-label={g.f ? g.f.name : 'Other models'}>
            <div class="sticky-h">
              {g.f ? (
                <>
                  {vendorOf(g.f) && <span class="m-gh-soft">{vendorOf(g.f)} · </span>}
                  <span class="m-gh-name">{g.f.name}</span>
                  {g.f.auto && <span class="m-gh-soft"> · {AUTO_NOTE}</span>}
                  <span class="m-gh-soft" data-m-nprov>{nprovText(g.nprov)}</span>
                </>
              ) : (
                <>
                  <span class="m-gh-name">Other models</span>
                  <span class="m-gh-soft"> · no known family or vendor · <span data-m-n>{g.rows.length}</span></span>
                </>
              )}
            </div>
            <div class="srows">
              {g.rows.map((x, i) => {
                const t = formatTokens(x.m.context_window);
                return (
                  <div class="srow" {...rowAttrs(x, g)} hidden={fold && i >= fold ? true : undefined}>
                    <div class="idline">
                      <span class="mono">{x.m.id}</span>
                      <CopyButton value={x.m.id} label="model ID" />
                      <span class="use"><a class="lnk m-nowrap" href={useHref(x)} aria-label={`Use ${x.m.id} from ${x.p.name} in Quick start`}>Use →</a></span>
                    </div>
                    <div class="facts">
                      <span class="m-prov"><StatusSlot providerId={x.p.id} liveOnly /><a class="lnk" href={`/providers/${x.p.id}`}>{x.p.name}</a></span>
                      {x.rpd != null && <><span class="sep" aria-hidden="true">·</span><span><span class="num">{formatCount(x.rpd)}</span> RPD</span></>}
                      {x.rpm != null && <><span class="sep" aria-hidden="true">·</span><span><span class="num">{formatCount(x.rpm)}</span> RPM</span></>}
                      {x.pub && (x.rpd == null || x.rpm == null) && <><span class="sep" aria-hidden="true">·</span><span>{x.rpd == null ? 'RPD' : 'RPM'} not published</span></>}
                      {!x.pub && <><span class="sep" aria-hidden="true">·</span><span>Limits not published</span></>}
                      {t && <><span class="sep" aria-hidden="true">·</span><span><span class="num" title={t.title}>{t.text}</span> context</span></>}
                      {x.caps.length > 0 && <><span class="sep" aria-hidden="true">·</span><span class="m-caps">{x.caps.map(c => <span class="tag tag-o">{c}</span>)}</span></>}
                    </div>
                  </div>
                );
              })}
            </div>
            {fold > 0 && (
              <div class="m-fold" data-m-more-row>
                <button type="button" class="btn btn-sm" data-m-toggle={g.key} aria-expanded="false">{moreLabel(g, fold)}</button>
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  .m-caption { margin-bottom: 12px; max-width: 72ch; }
  .m-tbl tr.grp .m-gh-name, .m-list .m-gh-name { color: var(--text-secondary); }
  .m-gh-soft { font-weight: 400; color: var(--text-muted); }
  .m-pcell { gap: 8px; }
  .m-nowrap { white-space: nowrap; }
  .m-caps { display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .m-prov { display: inline-flex; align-items: center; gap: 6px; }
  .m-grp + .m-grp { margin-top: 8px; }
  .m-fold { margin: 4px 0 8px; }
  .m-tbl tbody tr[data-m-more-row] td { padding-block: 10px; }
</style>

<script>
  import { setChip, chipEnabled } from '../../components/ui';

  type Filters = { q: string; vision: boolean; reasoning: boolean; code: boolean; pub: boolean; prov: string };
  interface Item { key: string; search: string; caps: string[]; pub: boolean; prov: string }

  const results = document.getElementById('m-results');
  const empty = document.getElementById('m-empty');
  const emptyText = document.getElementById('m-empty-text');
  const countEl = document.getElementById('m-count');
  const provSelect = document.getElementById('m-prov') as HTMLSelectElement | null;
  const search = document.getElementById('m-q') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#m-chips [data-chip]'));
  // Desktop rows are the canonical list (mobile rows carry the same keys).
  const items: Item[] = Array.from(document.querySelectorAll<HTMLElement>('.m-tbl [data-m-row]')).map(el => ({
    key: el.dataset.key ?? '',
    search: el.dataset.search ?? '',
    caps: (el.dataset.caps ?? '').split(' ').filter(Boolean),
    pub: el.dataset.pub === 'true',
    prov: el.dataset.prov ?? '',
  }));

  const f: Filters = { q: (search?.value ?? '').trim().toLowerCase(), vision: false, reasoning: false, code: false, pub: false, prov: provSelect?.value ?? '' };
  const open = new Set<string>();

  const matches = (x: Item, o: Partial<Filters> = {}) => {
    const s = { ...f, ...o };
    if (s.q && !x.search.includes(s.q)) return false;
    if (s.vision && !x.caps.includes('vision')) return false;
    if (s.reasoning && !x.caps.includes('reasoning')) return false;
    if (s.code && !x.caps.includes('code')) return false;
    if (s.pub && !x.pub) return false;
    if (s.prov && x.prov !== s.prov) return false;
    return true;
  };
  const countWith = (o: Partial<Filters>) => items.reduce((n, x) => n + (matches(x, o) ? 1 : 0), 0);

  function numSpan(n: number) {
    const s = document.createElement('span');
    s.className = 'num';
    s.textContent = String(n);
    return s;
  }

  function apply() {
    const shown = new Set(items.filter(x => matches(x)).map(x => x.key));
    const filtered = shown.size !== items.length || !!(f.q || f.vision || f.reasoning || f.code || f.pub || f.prov);

    for (const chip of chips) {
      const name = chip.dataset.chip as 'vision' | 'reasoning' | 'code' | 'pub';
      setChip(chip, { count: countWith({ [name]: true }), pressed: f[name], hideIfTotal: shown.size });
    }

    if (countEl) {
      if (filtered) countEl.replaceChildren(numSpan(shown.size), ' of ', numSpan(items.length), ' listings');
      else countEl.replaceChildren();
    }

    const none = shown.size === 0;
    if (results) results.hidden = none;
    if (empty) empty.hidden = !none;
    if (none && emptyText) {
      emptyText.textContent = `${f.q ? `No model matches “${search?.value.trim() ?? f.q}”.` : 'No model matches these filters.'} Try a family name like gemma, glm or qwen.`;
    }

    document.querySelectorAll<HTMLElement>('[data-m-group]').forEach(group => {
      const key = group.dataset.mGroup ?? '';
      const rows = Array.from(group.querySelectorAll<HTMLElement>('[data-m-row]'));
      const visible = rows.filter(r => shown.has(r.dataset.key ?? ''));
      const foldAt = Number(group.dataset.fold) || 0;
      // Folding applies only to the unfiltered list; a filtered list shows every match.
      const foldable = !filtered && foldAt > 0 && visible.length > foldAt + 1;
      const limit = foldable && !open.has(key) ? foldAt : Infinity;
      let i = 0;
      for (const r of rows) {
        const hit = shown.has(r.dataset.key ?? '');
        r.hidden = !hit || i >= limit;
        if (hit) i++;
      }
      group.hidden = visible.length === 0;
      const nprov = group.querySelector('[data-m-nprov]');
      if (nprov) {
        const n = new Set(visible.map(r => r.dataset.prov)).size;
        nprov.textContent = ` · ${n} provider${n === 1 ? '' : 's'}`;
      }
      const n = group.querySelector('[data-m-n]');
      if (n) n.textContent = String(visible.length);
      const moreRow = group.querySelector<HTMLElement>('[data-m-more-row]');
      const btn = group.querySelector<HTMLButtonElement>('[data-m-toggle]');
      if (moreRow) moreRow.hidden = !foldable;
      if (btn && foldable) {
        const expanded = open.has(key);
        const name = key === 'other' ? '' : ` ${group.querySelector('.m-gh-name')?.textContent ?? ''}`;
        btn.setAttribute('aria-expanded', String(expanded));
        btn.textContent = expanded ? 'Show fewer' : `Show ${visible.length - foldAt} more${name}`;
      }
    });
  }

  window.addEventListener('search-change', event => {
    const detail = (event as CustomEvent<{ id: string; value: string }>).detail;
    if (detail?.id !== 'm-q') return;
    f.q = detail.value.toLowerCase();
    apply();
  });

  document.getElementById('m-chips')?.addEventListener('click', event => {
    const chip = (event.target as Element).closest<HTMLButtonElement>('[data-chip]');
    if (!chip || !chipEnabled(chip)) return;
    const name = chip.dataset.chip as 'vision' | 'reasoning' | 'code' | 'pub';
    f[name] = !f[name];
    apply();
  });

  provSelect?.addEventListener('change', () => { f.prov = provSelect.value; apply(); });

  document.addEventListener('click', event => {
    const btn = (event.target as Element | null)?.closest?.('[data-m-toggle]') as HTMLButtonElement | null;
    if (!btn) return;
    const key = btn.dataset.mToggle ?? '';
    if (open.has(key)) open.delete(key); else open.add(key);
    apply();
    btn.focus({ preventScroll: true });
  });

  document.getElementById('m-clear')?.addEventListener('click', () => {
    f.vision = f.reasoning = f.code = f.pub = false;
    f.prov = '';
    if (provSelect) provSelect.value = '';
    if (search && search.value) {
      search.value = '';
      // The SearchInput clear button rewrites ?q= and fires search-change, which re-applies.
      document.querySelector<HTMLButtonElement>('[data-search-clear="m-q"]')?.click();
    } else {
      f.q = '';
      apply();
    }
    search?.focus();
  });

  apply();
</script>
