---
// Tools (/configs): plug the active free providers into LiteLLM (generated config) or set them up by hand
// in Open WebUI, LobeChat and Cursor. Everything renders server-side for every active provider; the client
// script only narrows it to the selected providers and switches the visible tool.
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CopyField from '../../components/CopyField.astro';
import CopyButton from '../../components/CopyButton.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import Icon from '../../components/Icon.astro';
import { siteURL } from '../../lib/site-url';
import { getProviders } from '../../lib/providers';
import { apiKeyEnvName, formatDate, yamlString } from '../../lib/format';

const providers = getProviders(Astro.locals);
// Archived providers are never offered here.
const active = providers.filter(p => p.status === 'active');

// "Catalog" date = newest machine catalog check or human verification across active providers (not render time).
const catalogDates = active
  .flatMap(p => [p.catalog_checked_at, p.last_verified])
  .filter((d): d is string => typeof d === 'string' && Number.isFinite(Date.parse(d)));
const lastUpdated = catalogDates.length
  ? formatDate(new Date(Math.max(...catalogDates.map(d => Date.parse(d)))).toISOString())
  : null;
const catalogRevision = Astro.locals.catalog?.origin === 'live' ? Astro.locals.catalog.revision : null;

// Same variable name as the provider page: derived from the public id (lib/format.ts), never from
// api_key_env, which is the checker's secret binding name and not part of the public catalog.
const keyEnv = (p: { id: string }) => apiKeyEnvName(p.id);
const keyUrl = (p: { signup_url?: string; website_url?: string }) => p.signup_url || p.website_url || null;

// One LiteLLM model_list block per provider: every top model, routed through the provider's
// OpenAI-compatible base URL. Values are JSON-quoted so ids/URLs with ':' or '#' stay literal.
const yamlBlock = (p: (typeof active)[number]) => p.top_models.map(m =>
  `  - model_name: ${yamlString(`${p.id}/${m.split('/').pop()}`)}
    litellm_params:
      model: ${yamlString(`openai/${m}`)}
      api_base: ${yamlString(p.base_url)}
      api_key: ${yamlString(`os.environ/${keyEnv(p)}`)}`).join('\n');

// Keep in sync with buildYaml() in the client script below.
const yamlDate = lastUpdated ?? 'unknown';
function buildYaml(date: string, blocks: string[]) {
  const body = blocks.filter(Boolean);
  return [
    '# LiteLLM proxy config, generated by Free LLM APIs',
    `# Catalog as of ${date} · ${blocks.length} ${blocks.length === 1 ? 'provider' : 'providers'}`,
    '# Each api_key is read from the environment variable named after os.environ/',
    '',
    body.length ? `model_list:\n${body.join('\n')}` : 'model_list: []',
    '',
    'litellm_settings:',
    '  drop_params: true',
  ].join('\n');
}
const rows = active.map(p => ({ p, env: keyEnv(p), url: keyUrl(p), yaml: yamlBlock(p) }));
const yaml = buildYaml(yamlDate, rows.map(r => r.yaml));
const modelTotal = active.reduce((n, p) => n + p.top_models.length, 0);

const runCommand = "pip install 'litellm[proxy]'\nlitellm --config config.yaml";

const MANUAL = [
  {
    id: 'openwebui', name: 'Open WebUI', docs: 'https://docs.openwebui.com', docsLabel: 'Open WebUI docs',
    steps: [
      'Open Admin Settings → Connections and add one OpenAI API connection per provider below.',
      'Paste the Base URL, and the API key you created for that provider.',
      'Save, then add the model IDs to the connection, or let Open WebUI fetch them from /models.',
    ],
  },
  {
    id: 'lobechat', name: 'LobeChat', docs: 'https://lobehub.com/docs', docsLabel: 'LobeChat docs',
    steps: [
      'Open Settings → AI Service Provider and add a custom OpenAI-compatible provider.',
      'Paste the Base URL as the API proxy address, and your API key.',
      'Add the model IDs below to the provider’s model list and enable them.',
    ],
  },
  {
    id: 'cursor', name: 'Cursor', docs: 'https://docs.cursor.com/context/model-context', docsLabel: 'Cursor models docs',
    steps: [
      'Open Cursor Settings → Models.',
      'Turn on “Override OpenAI Base URL”, then paste the Base URL and your API key.',
      'Add a model ID below as a custom model and verify it. Custom endpoints depend on your Cursor plan.',
    ],
  },
];
const TOOLS = [{ id: 'litellm', name: 'LiteLLM proxy', rec: true }, ...MANUAL.map(t => ({ id: t.id, name: t.name, rec: false }))];
---

<Layout
  title="Use Free LLM APIs in LiteLLM, Open WebUI, LobeChat, Cursor"
  description={`Get a LiteLLM proxy config for ${active.length} active free LLM API providers, or the base URLs, model IDs and key names for Open WebUI, LobeChat and Cursor.`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Tools",
    "description": "Use free LLM API providers in LiteLLM, Open WebUI, LobeChat and Cursor.",
    "url": siteURL(Astro.site, '/configs/'),
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL(Astro.site) },
        { "@type": "ListItem", "position": 2, "name": "Tools", "item": siteURL(Astro.site, '/configs/') }
      ]
    }
  }}
>
  <PageHeader title="Use free models in your tools" lead="Pick providers, then copy a ready LiteLLM config or the values to paste into your app.">
    <Fragment slot="meta"><span class="num">{active.length}</span> {active.length === 1 ? 'provider' : 'providers'} · catalog {lastUpdated ? <span class="date"><time datetime={lastUpdated}>{lastUpdated}</time></span> : 'date unknown'}{catalogRevision && <> · rev <span class="mono">{catalogRevision.slice(0, 12)}</span></>}</Fragment>
  </PageHeader>

  {active.length === 0 ? (
    <div class="empty"><p>No provider currently offers a free tier in this directory.</p></div>
  ) : (
    <div id="tools" data-yaml-date={yamlDate}>
      <section class="sect tools-first" aria-labelledby="t1-h">
        <div class="step-h">
          <span class="step-n" aria-hidden="true">1</span>
          <h2 class="h2" id="t1-h">Providers</h2>
          <span class="caption" id="t-selcount" aria-live="polite"><span class="num">{active.length}</span> of <span class="num">{active.length}</span> selected</span>
          <span class="t-allnone">
            <button type="button" class="lnk" id="t-all">All</button>
            <span class="muted" aria-hidden="true">·</span>
            <button type="button" class="lnk" id="t-none">None</button>
          </span>
        </div>
        <div class="pgrid" role="group" aria-labelledby="t1-h">
          {rows.map(({ p, yaml: block }) => (
            <span class="pchk">
              <input type="checkbox" id={`t-p-${p.id}`} data-tp={p.id} data-yaml={block} data-models={p.top_models.length} checked />
              <label for={`t-p-${p.id}`}><span class="box"><Icon name="check" /></span><ProviderLogo provider={p} size={20} />{p.name}</label>
            </span>
          ))}
        </div>
      </section>

      <section class="sect tools-second" aria-labelledby="t2-h">
        <div class="step-h">
          <span class="step-n" aria-hidden="true">2</span>
          <h2 class="h2" id="t2-h">Tool</h2>
        </div>
        <div class="seg tool-seg" role="group" aria-labelledby="t2-h">
          {TOOLS.map((t, i) => (
            <button type="button" data-tool={t.id} aria-pressed={i === 0 ? 'true' : 'false'}>{t.name}{t.rec && <span class="rec">Recommended</span>}</button>
          ))}
        </div>
        <label class="sr-only" for="t-tool-m">Tool</label>
        <select class="select tool-sel-m" id="t-tool-m">
          {TOOLS.map((t, i) => <option value={t.id} selected={i === 0}>{t.name}{t.rec ? ' (recommended)' : ''}</option>)}
        </select>

        <div class="panel" id="t-empty" hidden>
          <div class="empty tools-empty">
            <p>Select at least one provider.</p>
            <button type="button" class="btn" id="t-empty-all">Select all providers</button>
          </div>
        </div>

        <div class="panel" id="t-panel-litellm" data-tool-panel="litellm" role="region" aria-label="LiteLLM proxy setup">
          <div class="tools-acts">
            <button type="button" class="btn btn-p" data-download-from="t-yaml" data-download-filename="config.yaml"><Icon name="download" size={14} /> Download config.yaml</button>
            <button type="button" class="btn" data-copy-from="t-yaml" data-copy-toast="config.yaml copied" aria-label="Copy config.yaml"><Icon name="copy" size={14} /> Copy</button>
            <span class="caption" id="t-modelcount"><span class="num">{modelTotal}</span> models from <span class="num">{active.length}</span> {active.length === 1 ? 'provider' : 'providers'}</span>
          </div>
          <div>
            <p class="h3 tools-sub">Then run</p>
            <CodeBlock code={runCommand} language="bash" id="t-run" wrap={true} />
            <p class="caption tools-note">Export each API key variable listed under “API keys you need” before you start the proxy.</p>
          </div>
          <div>
            <p class="h3 tools-sub">config.yaml</p>
            <CodeBlock code={yaml} language="yaml" title="config.yaml" id="t-yaml" foldLines={14} />
          </div>
          <p class="caption">Proxy docs: <a class="lnk" href="https://docs.litellm.ai/docs/proxy/quick_start" target="_blank" rel="noopener noreferrer">LiteLLM quick start ↗</a></p>
        </div>

        <div class="panel" id="t-panel-manual" data-tool-panel="manual" role="region" aria-label="Manual setup" hidden>
          {MANUAL.map(t => (
            <div class="tools-manual" data-manual-for={t.id} hidden>
              <div class="tools-manual-h"><span class="tag">Manual setup</span><span class="caption">{t.name} doesn’t import a file. Paste these values for each provider.</span></div>
              <ol class="steps">{t.steps.map(s => <li>{s}</li>)}</ol>
              <p class="caption">Docs: <a class="lnk" href={t.docs} target="_blank" rel="noopener noreferrer">{t.docsLabel} ↗</a></p>
            </div>
          ))}
          <div class="mcards">
            {rows.map(({ p, env }) => (
              <div class="mcard" data-tp-item={p.id}>
                <div class="pcard-1"><ProviderLogo provider={p} size={20} /><span class="nm tools-nm">{p.name}</span></div>
                <CopyField label="Base URL" value={p.base_url} id={`mc-b-${p.id}`} toast="Base URL copied" />
                <div class="cf">
                  <span class="cf-l">Model IDs</span>
                  {p.top_models.length ? (
                    <div class="tools-ids">
                      {p.top_models.map(m => (
                        <button type="button" class="idchip" data-copy={m} data-copy-toast="Model ID copied" aria-label={`Copy model ID ${m}`} title={m}><span>{m}</span><Icon name="copy" size={12} /></button>
                      ))}
                    </div>
                  ) : <span class="caption">No model IDs listed. Use the provider’s /models endpoint.</span>}
                </div>
                <CopyField label="API key variable" value={env} id={`mc-k-${p.id}`} toast="Variable name copied" />
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="sect" aria-labelledby="t3-h">
        <div class="sect-head">
          <h2 class="h2" id="t3-h">API keys you need</h2>
          <span class="caption">Create a key for each provider and export it under this name.</span>
        </div>
        <div class="keys" id="t-keys">
          {rows.map(({ p, env, url }) => (
            <div class="keyrow" data-tp-item={p.id}>
              <div class="pcard-1"><ProviderLogo provider={p} size={20} /><a class="lnk tools-kname" href={`/providers/${p.id}`}>{p.name}</a></div>
              <div class="cf-b"><span class="cf-v" id={`k-${p.id}`}>{env}</span><CopyButton from={`k-${p.id}`} label={`${p.name} API key variable`} toast="Variable name copied" /></div>
              {url ? <a class="lnk tools-getkey tools-keylink" href={url} target="_blank" rel="noopener noreferrer">Get key ↗</a> : <span class="caption tools-keylink">No sign-up link</span>}
            </div>
          ))}
        </div>
        <p class="muted tools-keys-empty" id="t-keys-empty" hidden>No providers selected.</p>
      </section>
    </div>
  )}
</Layout>

<style>
  .tools-first { margin-top: 16px; }
  .tools-second { margin-top: 28px; }
  .t-allnone { margin-left: auto; display: inline-flex; gap: 6px; align-items: baseline; font-size: 13px; }
  .t-allnone button { cursor: pointer; }
  .tools-empty { border: 0; }
  .tools-acts { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .tools-sub { margin-bottom: 8px; }
  .tools-note { margin-top: 8px; }
  .tools-manual { display: grid; gap: 12px; }
  .tools-manual-h { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .tools-nm { font-size: 14px; }
  .tools-ids { display: flex; flex-wrap: wrap; gap: 6px; min-width: 0; }
  .tools-kname { font-weight: 500; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tools-getkey { font-size: 13px; white-space: nowrap; }
  .tools-keys-empty { font-size: 14px; }
  @media (max-width: 639px) { .tools-keylink { grid-row: 1; grid-column: 2; } }
</style>

<script>
  import { setCodeBlock } from '../../components/ui';

  const root = document.getElementById('tools');
  if (root) {
    const yamlDate = root.dataset.yamlDate ?? 'unknown';
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-tp]'));
    const segButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('.tool-seg [data-tool]'));
    const mobileSelect = document.getElementById('t-tool-m') as HTMLSelectElement | null;
    const TOOL_IDS = segButtons.map(b => b.dataset.tool!);
    const $ = (id: string) => document.getElementById(id);

    // Keep in sync with buildYaml() in the frontmatter.
    function buildYaml(date: string, blocks: string[]) {
      const body = blocks.filter(Boolean);
      return [
        '# LiteLLM proxy config, generated by Free LLM APIs',
        `# Catalog as of ${date} · ${blocks.length} ${blocks.length === 1 ? 'provider' : 'providers'}`,
        '# Each api_key is read from the environment variable named after os.environ/',
        '',
        body.length ? `model_list:\n${body.join('\n')}` : 'model_list: []',
        '',
        'litellm_settings:',
        '  drop_params: true',
      ].join('\n');
    }

    function setCounts(el: HTMLElement | null, parts: (string | number)[]) {
      if (!el) return;
      el.replaceChildren(...parts.map(part => {
        if (typeof part === 'string') return document.createTextNode(part);
        const n = document.createElement('span');
        n.className = 'num';
        n.textContent = String(part);
        return n;
      }));
    }

    let tool = 'litellm';
    const fromQuery = new URLSearchParams(location.search).get('tool');
    if (fromQuery && TOOL_IDS.includes(fromQuery)) tool = fromQuery;

    function update() {
      const selected = boxes.filter(b => b.checked);
      const ids = new Set(selected.map(b => b.dataset.tp));
      const none = selected.length === 0;

      setCounts($('t-selcount'), [selected.length, ' of ', boxes.length, ' selected']);
      root!.querySelectorAll<HTMLElement>('[data-tp-item]').forEach(el => { el.hidden = !ids.has(el.dataset.tpItem); });

      const models = selected.reduce((n, b) => n + Number(b.dataset.models || 0), 0);
      setCounts($('t-modelcount'), [models, ' models from ', selected.length, selected.length === 1 ? ' provider' : ' providers']);
      setCodeBlock('t-yaml', buildYaml(yamlDate, selected.map(b => b.dataset.yaml ?? '')));

      segButtons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.tool === tool)));
      if (mobileSelect) mobileSelect.value = tool;
      $('t-empty')!.hidden = !none;
      $('t-panel-litellm')!.hidden = none || tool !== 'litellm';
      $('t-panel-manual')!.hidden = none || tool === 'litellm';
      root!.querySelectorAll<HTMLElement>('[data-manual-for]').forEach(el => { el.hidden = el.dataset.manualFor !== tool; });
      $('t-keys-empty')!.hidden = !none;
    }

    function setTool(next: string) {
      if (!TOOL_IDS.includes(next)) return;
      tool = next;
      const url = new URL(location.href);
      if (tool === 'litellm') url.searchParams.delete('tool'); else url.searchParams.set('tool', tool);
      history.replaceState(history.state, '', url);
      update();
    }

    const setAll = (on: boolean) => { boxes.forEach(b => { b.checked = on; }); update(); };
    $('t-all')?.addEventListener('click', () => setAll(true));
    $('t-none')?.addEventListener('click', () => setAll(false));
    $('t-empty-all')?.addEventListener('click', () => { setAll(true); boxes[0]?.focus(); });
    boxes.forEach(b => b.addEventListener('change', update));
    segButtons.forEach(b => b.addEventListener('click', () => setTool(b.dataset.tool!)));
    mobileSelect?.addEventListener('change', () => setTool(mobileSelect.value));

    // Browsers may restore checkbox state on back/forward; render from the actual state.
    update();
    window.addEventListener('pageshow', update);
  }
</script>
