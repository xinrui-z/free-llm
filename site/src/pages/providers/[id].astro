---
// Provider fact page. Active providers: header (access, key, base URL) → Free tier → Quick start →
// Models → Health (live only) → Notes → Paid rates (collapsed) → Free alternatives.
// Archived providers use a compact template: one archive notice, alternatives first, history collapsed.
// Works in both catalog modes: static (prerendered from src/data/providers) and dynamic
// (per-request from Astro.locals.catalog; Layout shows the stale/snapshot notice).
import Layout from '../../layouts/Layout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import CopyButton from '../../components/CopyButton.astro';
import CopyField from '../../components/CopyField.astro';
import Fold from '../../components/Fold.astro';
import Icon from '../../components/Icon.astro';
import LimitFacts from '../../components/LimitFacts.astro';
import NotPublished from '../../components/NotPublished.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import ProviderRow from '../../components/ProviderRow.astro';
import StatusNotice from '../../components/StatusNotice.astro';
import { siteURL } from '../../lib/site-url';
import {
  NO_CONTEXT_NOTE, accessLine, apiKeyEnvName, archiveDate, formatCount, formatDate, formatRate, formatTokens, limitsOf, modelDisplayName, providerLastmod, providerMetaDescription, shellQuote, shortHost,
} from '../../lib/format';
import { sortModels } from '../../../../scripts/lib/catalog-validation.mjs';
import { MODEL_FAMILIES } from '../../data/model-families';
import { CAPABILITY_SHORT, capabilityChip, inputModalities, modelCapabilities } from '../../lib/capabilities';
import { LIMIT_LABELS, SCOPE_LABELS, hasStructuredLimits, limitRows } from '../../lib/limits';
import changelog from '../../data/changelog.json';

import fallbackProviders, { type Provider, type ProviderModel } from '../../data/providers';
import { getProviders } from '../../lib/providers';

export function getStaticPaths() {
  return fallbackProviders.map(p => ({
    params: { id: p.id },
    props: { provider: p },
  }));
}

const providers = getProviders(Astro.locals);
const provider = providers.find(p => p.id === Astro.params.id);
// Unknown id: a body-less 404, which Astro reroutes to the custom 404 page (still status 404).
if (!provider) return Astro.locals.catalog?.unavailable
  ? new Response('Live catalog unavailable. Please try again shortly.', { status: 503 })
  : new Response(null, { status: 404 });

const p: Provider = provider;
const archived = p.status === 'archived';
// Upstream API order, with any manually pinned models (model_order) first.
const models: ProviderModel[] = sortModels(p.models ?? [], p.model_order);
const L = limitsOf(p);
const sources = (p.sources ?? []).filter(s => s && s.url);
const verified = formatDate(p.last_verified);

/* ---------- model families (alternatives, tags) ---------- */
const familyOf = (id: string) => MODEL_FAMILIES.find(f => f.match(id));
const familiesOf = (list: { id: string }[] = []) => new Set(list.map(m => familyOf(m.id)?.id).filter((x): x is string => !!x));
const ownFamilies = familiesOf(models);

// Archived providers are never recommended: alternatives are active providers only, ranked by the number
// of model families they share with this provider, then published TPM, then catalog order.
const alternatives = providers
  .map((o, order) => ({ o, order, shared: [...familiesOf(o.models)].filter(f => ownFamilies.has(f)).length }))
  .filter(x => x.o.status === 'active' && x.o.id !== p.id)
  .sort((a, b) => b.shared - a.shared || (limitsOf(b.o).tpm ?? -1) - (limitsOf(a.o).tpm ?? -1) || a.order - b.order)
  .slice(0, 3);
const sharedCount = alternatives.filter(x => x.shared > 0).length;
// One caption, under the heading, on active and archived pages alike.
const altCaption = !alternatives.length ? '' : sharedCount === alternatives.length ? 'Active providers serving the same model families.'
  : sharedCount ? 'Active providers serving the same model families come first.' : 'Other active providers with a free tier.';

// Tags as neutral chips. A tag that names a model family none of the listed models belongs to
// (e.g. a stale "llama" tag) is dropped so the header never advertises models the page does not list.
const TAG_TEXT: Record<string, string> = {
  'openai-compatible': 'OpenAI-compatible', 'function-call': 'function calling', 'china-available': 'available in China',
  thinking: 'reasoning', rag: 'RAG',
};
const tags = (p.tags ?? []).filter(t => {
  const fams = MODEL_FAMILIES.filter(f => f.id === t || f.id.replace(/[0-9-].*$/, '') === t);
  return !fams.length || models.some(m => fams.some(f => f.match(m.id)));
}).map(t => TAG_TEXT[t] ?? t.replace(/-/g, ' '));

/* ---------- API key variable ---------- */
// Only a suggested variable name; any name works. Derived from the public id (lib/format.ts), never from
// api_key_env (the checker's secret binding name), so static and live pages and the Tools page agree.
const envVar = apiKeyEnvName(p.id);

/* ---------- Quick start ---------- */
// Templates hold a sentinel where the model ID goes; the same fill rule runs on the server and in the
// client script below. Every catalog value is quoted for its language, so an unusual URL or model ID
// cannot break out of the snippet.
const SENTINEL = '__QUICK_START_MODEL__';
const modelIds = models.map(m => m.id);
const topModel = p.top_models?.find(id => modelIds.includes(id));
const defaultModel = topModel ?? modelIds[0] ?? 'your-model-id';
const base = p.base_url.replace(/\/+$/, '');
const templates: Record<string, string> = {
  curl: `export ${envVar}="your-api-key"

curl ${shellQuote(`${base}/chat/completions`)} \\
  -H "Authorization: Bearer $${envVar}" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": ${SENTINEL},
    "messages": [{"role": "user", "content": "Hello!"}]
  }'`,
  python: `# pip install openai
import os
from openai import OpenAI

client = OpenAI(
    base_url=${JSON.stringify(p.base_url)},
    api_key=os.environ[${JSON.stringify(envVar)}],
)

resp = client.chat.completions.create(
    model=${SENTINEL},
    messages=[{"role": "user", "content": "Hello!"}],
)
print(resp.choices[0].message.content)`,
  node: `// npm install openai
import OpenAI from "openai";

const client = new OpenAI({
  baseURL: ${JSON.stringify(p.base_url)},
  apiKey: process.env.${envVar},
});

const resp = await client.chat.completions.create({
  model: ${SENTINEL},
  messages: [{ role: "user", content: "Hello!" }],
});
console.log(resp.choices[0].message.content);`,
};
const fillSnippet = (template: string, lang: string, model: string) =>
  template.split(SENTINEL).join(lang === 'curl' ? JSON.stringify(model).replace(/'/g, `'\\''`) : JSON.stringify(model));
const langs = [
  { id: 'curl', label: 'curl', language: 'bash' },
  { id: 'python', label: 'Python', language: 'python' },
  { id: 'node', label: 'Node.js', language: 'javascript' },
];

/* ---------- Models table ---------- */
const FIRST_MODELS = 8;
const showModelLimits = models.some(m => limitsOf(m).published);
const ctxOf = (m: { context_window?: unknown }) => formatTokens(m.context_window);
// Only documented modalities; a model without any is "Not disclosed", never assumed to be text.
const modalitiesOf = (m: ProviderModel) => inputModalities(m);
const showMaxOutput = models.some(m => formatTokens(m.max_output_tokens));
const capChip = capabilityChip;

/* ---------- Limits table ---------- */
const limitTable = limitRows(p);
const structuredLimits = hasStructuredLimits(p);
const oaiCompatible = (p.tags ?? []).includes('openai-compatible');

/* ---------- Notes ---------- */
// With published limits, quota_note is shown in the Free tier section (limitsSentence), not repeated here.
const notes: [string, string][] = [];
if (p.catalog_note) notes.push(['Catalog note', p.catalog_note]);

/* ---------- Free tier summary sentence ---------- */
// One plain sentence a crawler (and a reader) can quote: the published limits in the same number format
// as the facts above, then the provider's own terms (daily limits etc.). Only for published limits; the
// "How limits work" paragraph covers the rest.
const plural = (n: number, one: string, many: string) => `${formatCount(n)} ${n === 1 ? one : many}`;
const limitParts = [
  L.rpm != null && `${plural(L.rpm, 'request', 'requests')} per minute`,
  L.tpm != null && `${plural(L.tpm, 'token', 'tokens')} per minute`,
].filter(Boolean).join(' and ');
const limitsSentence = L.published
  ? `The ${p.name} free tier allows ${limitParts}.`
  : '';

/* ---------- Paid rates (after the free tier) ---------- */
const priced = models.filter(m => m.pricing && (formatRate(m.pricing.input_per_million) || formatRate(m.pricing.output_per_million)));
const paidCatalog = p.paid_models?.length ?? 0;
const showPaid = !archived && (priced.length > 0 || paidCatalog > 0 || !!p.pricing_note);
const paidNote = priced.length ? `(${priced.length} ${priced.length === 1 ? 'model' : 'models'})`
  : paidCatalog ? `(${paidCatalog} paid catalog ${paidCatalog === 1 ? 'model' : 'models'})` : undefined;
const pricingHref = `/pricing/?provider=${encodeURIComponent(p.id)}`;

/* ---------- Archived ---------- */
const archivedOn = archived ? archiveDate(p, changelog as { provider_id?: string; type?: string; date?: string }[]) : null;
const archiveSource = sources[0];
const showArchivedDesc = !!p.description && p.description !== p.archive_reason;

/* ---------- SEO ---------- */
const pageTitle = archived ? `${p.name} free API: archived, free alternatives` : `${p.name} free API: limits, models and quick start`;
const pageDescription = providerMetaDescription(p, { modelCount: models.length, alternatives: alternatives.length });
// Search results cut titles at about 60 characters; drop the site suffix when it would push past that.
const brandedTitle = `${pageTitle} · Free LLM APIs`;
const documentTitle = brandedTitle.length <= 60 ? brandedTitle : pageTitle;
const modified = providerLastmod(p);
---

<Layout
  title={documentTitle}
  description={pageDescription}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": siteURL(Astro.site, `/providers/${p.id}/`),
    ...(modified ? { "dateModified": modified } : {}),
    // The provider is described as an organization, not a SoftwareApplication: that type needs ratings
    // for Google's rich result, and this site collects none.
    "about": {
      "@type": "Organization",
      "name": p.name,
      ...(p.website_url ? { "url": p.website_url, "sameAs": [p.website_url] } : {})
    },
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL(Astro.site) },
        { "@type": "ListItem", "position": 2, "name": p.name, "item": siteURL(Astro.site, `/providers/${p.id}/`) }
      ]
    }
  }}
>
  <a class="crumb" href="/"><Icon name="back" size={14} />All providers</a>

  {archived ? (
    <>
      <header class="phd">
        <div class="phd-top">
          <div class="phd-id">
            <ProviderLogo provider={p} size={40} />
            <div class="min0">
              <div class="phd-name"><h1 class="h1" id="page-title" tabindex="-1">{p.name}</h1><span class="pill pill-neutral"><span class="dot d-unknown" aria-hidden="true"></span>Archived</span></div>
              {showArchivedDesc && <p class="phd-desc">{p.description}</p>}
              {p.website_url && (
                <p class="phd-acc"><a class="lnk muted" href={p.website_url} target="_blank" rel="noopener noreferrer">{shortHost(p.website_url)} ↗</a></p>
              )}
            </div>
          </div>
        </div>
      </header>

      <div class="arch-box" role="note">
        <div class="ttl">
          <span class="pill pill-neutral"><span class="dot d-unknown" aria-hidden="true"></span>Archived</span>
          <span>{archivedOn ? <><span class="date">{archivedOn}</span> · </> : null}No longer offers a recurring free tier.</span>
        </div>
        {p.archive_reason && <p class="sec">{p.archive_reason}</p>}
        {archiveSource && (
          <p class="caption">
            <a class="lnk" href={archiveSource.url} target="_blank" rel="noopener noreferrer">{archiveSource.label || 'Source'} ↗</a>
            {formatDate(archiveSource.checked_at) && <span> (checked <span class="date">{formatDate(archiveSource.checked_at)}</span>)</span>}
          </p>
        )}
        {alternatives.length > 0 && <div><a class="btn btn-p" href="#alternatives">See free alternatives</a></div>}
      </div>

      {alternatives.length > 0 && (
        <section class="sect" id="alternatives" tabindex="-1" aria-labelledby="alt-h">
          <div class="sect-head pp-alt-head"><h2 class="h2" id="alt-h">Free alternatives</h2><a class="lnk" href="/">All free providers →</a></div>
          {altCaption && <p class="caption pp-alt-cap">{altCaption}</p>}
          <div class="alts">{alternatives.map(x => <ProviderRow provider={x.o} />)}</div>
        </section>
      )}

      <section class="sect" aria-label="Historical record">
        <Fold>
          <Fragment slot="summary">Historical record <span class="muted">· last known catalog</span></Fragment>
          <dl class="dl">
            <div><dt>Access</dt><dd>{p.auth === 'credit_card_required' ? 'Required a credit card' : 'Required sign-up'}</dd></div>
            {verified && <div><dt>Last verified</dt><dd><span class="date">{verified}</span></dd></div>}
            {sources.length > 0 && (
              <div><dt>Sources</dt><dd class="pp-links">{sources.map(s => <a class="lnk" href={s.url} target="_blank" rel="noopener noreferrer">{s.label || shortHost(s.url)} ↗</a>)}</dd></div>
            )}
            {p.catalog_note && <div><dt>Catalog note</dt><dd>{p.catalog_note}</dd></div>}
            <div>
              <dt>Last known models (<span class="num">{formatCount(models.length)}</span>) · context</dt>
              <dd>
                {models.length > 0 && !models.some(m => ctxOf(m)) && <p class="caption">The last known catalog listed no context windows.</p>}
                {models.length ? (
                  <div class="srows">
                    {models.map(m => {
                      const c = ctxOf(m);
                      return (
                        <div class="srow pp-hist">
                          <span class="mono pp-hist-id">{m.id}</span>
                          {c ? <span class="num pp-hist-ctx" title={c.title}>{c.text}</span> : <span class="muted pp-hist-ctx">—</span>}
                        </div>
                      );
                    })}
                  </div>
                ) : <p class="caption">No models were listed.</p>}
              </dd>
            </div>
          </dl>
        </Fold>
      </section>
    </>
  ) : (
    <>
      <header class="phd">
        <div class="phd-top">
          <div class="phd-id">
            <ProviderLogo provider={p} size={40} />
            <div class="min0">
              <div class="phd-name">
                <h1 class="h1" id="page-title" tabindex="-1">{p.name} <span class="pp-h1-sub">free API</span></h1>
                <span data-live-status={p.id} data-live-only></span>
              </div>
              {p.description && <p class="phd-desc">{p.description}</p>}
              <p class="phd-acc">{accessLine(p)}</p>
              {tags.length > 0 && <div class="phd-tags">{tags.map(t => <span class="tag">{t}</span>)}</div>}
            </div>
          </div>
          {(p.signup_url || p.website_url) && (
            <div class="phd-acts">
              {p.signup_url && <a class="btn btn-p" href={p.signup_url} target="_blank" rel="noopener noreferrer">Get API key ↗</a>}
              {p.website_url && <a class="btn btn-t" href={p.website_url} target="_blank" rel="noopener noreferrer">Website ↗</a>}
            </div>
          )}
        </div>
        <div class="phd-cf">
          <CopyField label="Base URL" value={p.base_url} id="cf-base" toast="Base URL copied" />
          <CopyField label="API key variable" value={envVar} id="cf-env" toast="Variable name copied" />
        </div>
      </header>

      <StatusNotice providerId={p.id} class="pp-notice" />

      <section class="sect" aria-labelledby="ft-h">
        <div class="sect-head"><h2 class="h2" id="ft-h">{p.name} free tier limits</h2></div>
        <LimitFacts provider={p} size="large" />
        {limitsSentence && <p class="note-p">{limitsSentence}{p.quota_note && <> {p.quota_note}</>}</p>}
        {!L.published && p.quota_note && <p class="note-p"><b>How limits work:</b> {p.quota_note}</p>}
        <div class="tblwrap pp-limits">
          <table class="tbl">
            <caption class="sr-only">Free-tier limits by metric and scope</caption>
            <thead>
              <tr>
                <th scope="col">Limit</th>
                <th scope="col" class="r">Value</th>
                <th scope="col">Applies to</th>
                <th scope="col">Source</th>
                <th scope="col">Checked</th>
              </tr>
            </thead>
            <tbody>
              {limitTable.map(r => (
                <tr data-limit={r.metric}>
                  <th scope="row" class="pp-lim-name">{LIMIT_LABELS[r.metric].long} <span class="muted">({LIMIT_LABELS[r.metric].short})</span></th>
                  <td class="r">{r.value != null ? <span class="num">{formatCount(r.value)}</span> : <NotPublished note={p.quota_note} />}</td>
                  <td>
                    {r.scope
                      ? <button type="button" class="pp-scope" data-tip={SCOPE_LABELS[r.scope].note} aria-label={`${SCOPE_LABELS[r.scope].label}. ${SCOPE_LABELS[r.scope].note}`}>{SCOPE_LABELS[r.scope].label}{r.models?.length ? ` · ${r.models.length} ${r.models.length === 1 ? 'model' : 'models'}` : ''}</button>
                      : r.value != null ? <span class="muted">Scope not specified</span> : <span class="muted">—</span>}
                    {r.note && <span class="caption pp-lim-note">{r.note}</span>}
                  </td>
                  <td class="pp-lim-srccell">
                    {r.source_url
                      ? <a class="lnk pp-lim-src" href={r.source_url} target="_blank" rel="noopener noreferrer">{shortHost(r.source_url)} ↗</a>
                      : <span class="muted">{r.value != null ? 'Provider sources below' : '—'}</span>}
                  </td>
                  <td>{r.checked_at && formatDate(r.checked_at) ? <span class="date sec">{formatDate(r.checked_at)}</span> : <span class="muted">—</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="caption pp-mt6">
          {structuredLimits
            ? 'Each value is copied from the linked page; "Not disclosed" means the provider does not publish that limit. Your own account limits may differ.'
            : 'No per-metric limits are recorded here; RPM and TPM are the headline values, and daily or monthly caps are in the terms above. "Not disclosed" is never zero or unlimited.'}
        </p>
        {(verified || sources.length > 0) && (
          <div class="srcs">
            {verified && <span class="s pp-verified"><span class="pill pill-outline">Verified <span class="date">{verified}</span></span></span>}
            {formatDate(p.catalog_checked_at) && <span class="s">Model list synced <span class="date">{formatDate(p.catalog_checked_at)}</span></span>}
            {sources.map((s, i) => (
              <span class="s">
                {i === 0 && <>{sources.length === 1 ? 'Source:' : 'Sources:'} </>}
                <a class="lnk" href={s.url} target="_blank" rel="noopener noreferrer">{s.label || shortHost(s.url)} ↗</a>
              </span>
            ))}
          </div>
        )}
      </section>

      <section
        class="sect"
        id="quick-start"
        tabindex="-1"
        aria-labelledby="qs-h"
        data-qs-templates={JSON.stringify(templates)}
        data-qs-sentinel={SENTINEL}
        data-qs-default={defaultModel}
      >
        <div class="sect-head"><h2 class="h2" id="qs-h">Quick start</h2><span class="caption">{oaiCompatible ? 'OpenAI-compatible chat completion' : 'OpenAI-style request; compatibility is not documented in this catalog, so check the provider docs'}</span></div>
        <div class="qs-row">
          {modelIds.length > 0 && (
            <div class="qs-model">
              <label for="qs-model">Model</label>
              <select class="select" id="qs-model">
                {modelIds.map(id => <option value={id} selected={id === defaultModel}>{id}</option>)}
              </select>
            </div>
          )}
          <div class="seg" role="group" aria-label="Code language">
            {langs.map((l, i) => <button type="button" data-qs-lang={l.id} aria-pressed={i === 0 ? 'true' : 'false'}>{l.label}</button>)}
          </div>
        </div>
        {langs.map((l, i) => (
          <div data-qs-panel={l.id} hidden={i !== 0}>
            <CodeBlock code={fillSnippet(templates[l.id], l.id, defaultModel)} language={l.language} id={`qs-code-${l.id}`} />
          </div>
        ))}
      </section>

      <section class="sect" aria-labelledby="m-h">
        <div class="sect-head">
          <h2 class="h2" id="m-h">Free models on {p.name} <span class="muted pp-count">(<span class="num">{formatCount(models.length)}</span>)</span></h2>
          {models.length > 0 && !showModelLimits && <span class="caption">The provider does not publish per-model request limits.</span>}
        </div>
        {models.length === 0 ? (
          <p class="caption">The catalog lists no models for this provider.</p>
        ) : (
          <div class="pm-models" data-collapsed={models.length > FIRST_MODELS ? '' : undefined}>
            <div class="only-md tblwrap">
              <table class="tbl">
                <thead>
                  <tr>
                    <th scope="col">Model ID</th>
                    <th scope="col">Name</th>
                    <th scope="col" class="r">Context</th>
                    {showMaxOutput && <th scope="col" class="r">Max output</th>}
                    {showModelLimits && <th scope="col" class="r"><abbr title="Requests per minute">RPM</abbr></th>}
                    {showModelLimits && <th scope="col" class="r"><abbr title="Tokens per minute">TPM</abbr></th>}
                    <th scope="col">Input</th>
                    <th scope="col">Capabilities</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  {models.map((m, i) => {
                    const c = ctxOf(m);
                    const ml = limitsOf(m);
                    const mods = modalitiesOf(m);
                    const out = formatTokens(m.max_output_tokens);
                    return (
                      <tr data-pm-more={i >= FIRST_MODELS ? '' : undefined}>
                        <td>
                          <div class="idcell">
                            {m.status !== 'deprecated' && <span class="slot" data-live-only data-model-status data-model-provider={p.id} data-model-id={m.id}></span>}
                            <span class="mono">{m.id}</span>
                            <CopyButton value={m.id} label={`model ID ${m.id}`} toast="Model ID copied" />
                            {m.status === 'deprecated' && <span class="tag">Deprecated</span>}
                          </div>
                        </td>
                        <td class="pm-name">{modelDisplayName(m)}</td>
                        <td class="r">{c ? <span class="num" title={c.title}>{c.text}</span> : <NotPublished variant="dash" note={NO_CONTEXT_NOTE} />}</td>
                        {showMaxOutput && <td class="r">{out ? <span class="num" title={out.title}>{out.text}</span> : <NotPublished variant="dash" note="No maximum output length in the official catalog." />}</td>}
                        {showModelLimits && <td class="r">{ml.rpm != null ? <span class="num">{formatCount(ml.rpm)}</span> : <NotPublished variant="dash" note={p.quota_note} />}</td>}
                        {showModelLimits && <td class="r">{ml.tpm != null ? <span class="num">{formatCount(ml.tpm)}</span> : <NotPublished variant="dash" note={p.quota_note} />}</td>}
                        <td>{mods ? <span class="pm-mods">{mods.map(x => <span class="tag tag-o">{x}</span>)}</span> : <NotPublished variant="dash" note="The catalog lists no input modalities for this model." />}</td>
                        <td><span class="pm-mods">{modelCapabilities(m).filter(x => x.key !== 'vision').map(x => <button {...capChip(x)}>{CAPABILITY_SHORT[x.key]}</button>)}</span></td>
                        <td class="r"><button type="button" class="btn btn-sm" data-pm-use={m.id} aria-label={`Use ${m.id} in Quick start`}>Use</button></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
            <div class="only-sm srows">
              {models.map((m, i) => {
                const c = ctxOf(m);
                const ml = limitsOf(m);
                const vision = (modalitiesOf(m) ?? []).includes('image');
                return (
                  <div class="srow" data-pm-more={i >= FIRST_MODELS ? '' : undefined}>
                    <div class="idline">
                      {m.status !== 'deprecated' && <span class="slot" data-live-only data-model-status data-model-provider={p.id} data-model-id={m.id}></span>}
                      <span class="mono">{m.id}</span>
                      <CopyButton value={m.id} label={`model ID ${m.id}`} toast="Model ID copied" />
                    </div>
                    <div class="facts">
                      {c ? <span><span class="num" title={c.title}>{c.text}</span> context</span> : <span class="muted">No context listed</span>}
                      {ml.rpm != null && <><span class="sep" aria-hidden="true">·</span><span><span class="num">{formatCount(ml.rpm)}</span> RPM</span></>}
                      {ml.tpm != null && <><span class="sep" aria-hidden="true">·</span><span><span class="num">{formatCount(ml.tpm)}</span> TPM</span></>}
                      {vision && <><span class="sep" aria-hidden="true">·</span><span>vision</span></>}
                      {m.status === 'deprecated' && <><span class="sep" aria-hidden="true">·</span><span>deprecated</span></>}
                    </div>
                    <div><button type="button" class="btn btn-t btn-sm pm-use-m" data-pm-use={m.id} aria-label={`Use ${m.id} in Quick start`}>Use in Quick start →</button></div>
                  </div>
                );
              })}
            </div>
            {models.length > FIRST_MODELS && (
              <div class="pm-toggle">
                <button type="button" class="btn btn-sm" data-pm-toggle aria-expanded="false" data-label-more={`Show all ${models.length} models`}>Show all {models.length} models</button>
              </div>
            )}
            <noscript><style is:inline>.pm-models [data-pm-more]{display:revert !important}.pm-toggle{display:none !important}</style></noscript>
          </div>
        )}
      </section>

      <section class="sect" id="health" aria-labelledby="h-h" data-live-only data-provider-health={p.id} hidden>
        <div class="sect-head"><h2 class="h2" id="h-h">Health</h2><span class="caption">Scheduled API probes from the monitoring account</span></div>
        <div data-health-history hidden>
          <div class="strip" role="img" id="health-strip" aria-label="Daily health over the last 90 days"></div>
          <div class="strip-legend" aria-hidden="true"><span>90 days ago</span><span>today</span></div>
          <ul class="pp-legend" aria-label="Legend">
            <li><span class="pp-sw h-active"></span>Healthy</li>
            <li><span class="pp-sw h-degraded"></span>Degraded</li>
            <li><span class="pp-sw h-dead"></span>Unavailable</li>
            <li><span class="pp-sw"></span>No data</li>
          </ul>
          <p class="note-p">Healthy on <span class="num" data-live-uptime>—</span> of observed days<span> · last probe </span><span data-live-latency={p.id}></span></p>
          <p class="caption pp-mt6" id="history-coverage"></p>
        </div>
        <p class="caption pp-mt6" data-probe-coverage={p.id} aria-live="polite"></p>
        <p class="caption pp-mt6">Each day shows its worst probe result; days without probes are “No data” and count neither as healthy nor as an outage. The percentage is healthy days / observed days, not an uptime guarantee; your own access and limits may differ.</p>
      </section>

      {notes.length > 0 && (
        <section class="sect" aria-labelledby="n-h">
          <div class="sect-head"><h2 class="h2" id="n-h">Notes</h2></div>
          <dl class="dl">{notes.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}</dl>
        </section>
      )}

      {showPaid && (
        <section class="sect" aria-label="Paid rates after the free tier">
          <Fold summary="Paid rates after the free tier" note={paidNote}>
            {priced.length > 0 && (
              <>
                <p class="paid-h">Paid rate per 1M tokens from the provider's pricing page. These apply only after you go beyond the free tier.</p>
                <div class="only-md tblwrap">
                  <table class="tbl">
                    <thead>
                      <tr>
                        <th scope="col">Model ID</th>
                        <th scope="col" class="r">Input / 1M tokens</th>
                        <th scope="col" class="r">Output / 1M tokens</th>
                        <th scope="col"><span class="sr-only">Source</span></th>
                      </tr>
                    </thead>
                    <tbody>
                      {priced.map(m => {
                        const pr = m.pricing!;
                        const input = formatRate(pr.input_per_million, pr.currency);
                        const output = formatRate(pr.output_per_million, pr.currency);
                        const checked = formatDate(pr.checked_at);
                        const promo = formatDate(pr.valid_until);
                        return (
                          <tr>
                            <td>
                              <span class="mono pp-paid-id">{m.id}</span>
                              {promo && <span class="pill pill-accent pp-promo">Promo to <span class="date">{promo}</span></span>}
                            </td>
                            <td class="r">{input ? <span class="num">{input}</span> : <NotPublished variant="dash" note="No input rate on the official pricing page." />}</td>
                            <td class="r">{output ? <span class="num">{output}</span> : <NotPublished variant="dash" note="No output rate on the official pricing page." />}</td>
                            <td class="r">
                              {pr.source_url && (
                                <a class="lnk pp-src" href={pr.source_url} target="_blank" rel="noopener noreferrer" title={checked ? `Source checked ${checked}` : 'Price source'} aria-label={`Price source for ${m.id}`}><Icon name="ext" size={14} /></a>
                              )}
                            </td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                <div class="only-sm srows paid-rows">
                  {priced.map(m => {
                    const pr = m.pricing!;
                    const input = formatRate(pr.input_per_million, pr.currency);
                    const output = formatRate(pr.output_per_million, pr.currency);
                    const promo = formatDate(pr.valid_until);
                    return (
                      <div class="srow">
                        <span class="mono pp-paid-id">{m.id}</span>
                        <div class="facts">
                          <span>{input ? <span class="num">{input}</span> : '—'} in</span>
                          <span class="sep" aria-hidden="true">·</span>
                          <span>{output ? <span class="num">{output}</span> : '—'} out</span>
                          {pr.source_url && <><span class="sep" aria-hidden="true">·</span><a class="lnk pp-src-m" href={pr.source_url} target="_blank" rel="noopener noreferrer">Source ↗</a></>}
                        </div>
                        {promo && <span class="caption">Promotional rate until <span class="date">{promo}</span></span>}
                      </div>
                    );
                  })}
                </div>
              </>
            )}
            {p.pricing_note && <p class="sec">{p.pricing_note}</p>}
            {!priced.length && paidCatalog > 0 && (
              <p class="sec">Free variants have no per-token rate. {p.name} lists {formatCount(paidCatalog)} paid {paidCatalog === 1 ? 'model' : 'models'} with per-token prices.</p>
            )}
            <div><a class="lnk" href={pricingHref}>{paidCatalog > 0 ? `See ${formatCount(paidCatalog)} paid catalog ${paidCatalog === 1 ? 'model' : 'models'} →` : 'Compare all paid rates →'}</a></div>
          </Fold>
        </section>
      )}

      {alternatives.length > 0 && (
        <section class="sect" aria-labelledby="alt-h">
          <div class="sect-head pp-alt-head"><h2 class="h2" id="alt-h">Free alternatives</h2></div>
          {altCaption && <p class="caption pp-alt-cap">{altCaption}</p>}
          <div class="alts">{alternatives.map(x => <ProviderRow provider={x.o} />)}</div>
        </section>
      )}
    </>
  )}
</Layout>

<style>
  .pp-notice { margin-top: 16px; }
  .pp-strong { color: var(--text-secondary); }
  .pp-verified .pill { color: var(--text-secondary); }
  .pp-verified .date { font-size: inherit; }
  .pp-count { font-weight: 400; }
  /* "free API" after the provider name in the H1: part of the heading text, visually secondary. */
  .pp-h1-sub { font-weight: 400; color: var(--text-muted); }
  .pp-mt6 { margin-top: 6px; }
  .pp-links { display: flex; flex-wrap: wrap; gap: 4px 12px; }
  .pp-hist { padding: 6px 0; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 12px; }
  .pp-hist-id { font-size: 12.5px; color: var(--text-secondary); overflow-wrap: anywhere; min-width: 0; }
  .pp-hist-ctx { font-size: var(--fs-caption); color: var(--text-muted); }
  .pp-paid-id { font-size: 12.5px; color: var(--text-secondary); overflow-wrap: anywhere; }
  .pp-promo { margin-left: 8px; }
  .pp-promo .date { font-size: inherit; }
  /* 24x24 hit areas (WCAG 2.5.8) for the small source links. */
  .pp-src { display: inline-flex; align-items: center; justify-content: center; min-width: 24px; min-height: 24px; border-radius: var(--r-sm); color: var(--text-muted); }
  .pp-src:hover { background: var(--bg-elevated); }
  .pp-src-m { display: inline-flex; align-items: center; min-height: 24px; }
  .pp-alt-head { margin-bottom: 4px; }
  .pp-alt-cap { margin-bottom: 10px; }
  #health :global(.num) { white-space: nowrap; }
  /* Health legend: same swatches as the strip, so every colour is named. */
  .pp-legend { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 8px 0 0; padding: 0; list-style: none; font-size: var(--fs-caption); color: var(--text-muted); }
  .pp-legend li { display: inline-flex; align-items: center; gap: 6px; }
  .pp-sw { width: 10px; height: 10px; border-radius: 2px; background: var(--bg-overlay); }
  .pp-sw.h-active { background: var(--status-active); }
  .pp-sw.h-degraded { background: var(--status-degraded); }
  .pp-sw.h-dead { background: var(--status-dead); }
  .pm-name { font-size: var(--fs-data); color: var(--text-muted); }
  .pm-mods { display: inline-flex; flex-wrap: wrap; gap: 4px; }
  .pm-toggle { margin-top: 10px; }
  .pp-limits { margin-top: 12px; max-width: 60rem; }
  .pp-limits tbody th { font-weight: 400; text-align: left; color: var(--text-secondary); background: transparent; white-space: nowrap; padding: 8px 12px; border-bottom: 1px solid var(--border-subtle); font-size: var(--fs-data); }
  .pp-limits tbody tr:last-child th { border-bottom: 0; }
  .pp-scope { font: inherit; padding: 0; color: var(--text-secondary); text-decoration: underline dotted var(--text-subtle); text-underline-offset: 3px; cursor: help; white-space: nowrap; }
  .pp-lim-note { display: block; margin-top: 2px; }
  .pp-lim-src { font-size: var(--fs-data); white-space: nowrap; }
  .pm-use-m { padding: 0; }
  .pm-models[data-collapsed] [data-pm-more] { display: none; }
</style>

<script>
  import { onStatus } from '../../lib/status-client';
  import { summarizeHistory, type HealthStatus } from '../../lib/status';
  import { setCodeBlock, showToast } from '../../components/ui';

  /* ---------- Quick start: model switcher, language tabs, ?model= deep link ---------- */
  const qs = document.getElementById('quick-start');
  if (qs) {
    let templates: Record<string, string> = {};
    try { templates = JSON.parse(qs.dataset.qsTemplates ?? '{}'); } catch { /* keep the server-rendered code */ }
    const sentinel = qs.dataset.qsSentinel ?? '';
    const select = document.getElementById('qs-model') as HTMLSelectElement | null;
    const ids = select ? Array.from(select.options, o => o.value) : [];
    // Same rule as the server: JSON string literal, single quotes escaped for the shell-quoted curl body.
    const fill = (template: string, lang: string, model: string) =>
      template.split(sentinel).join(lang === 'curl' ? JSON.stringify(model).replace(/'/g, `'\\''`) : JSON.stringify(model));

    const setModel = (id: string) => {
      if (!select || !ids.includes(id) || !sentinel) return false;
      select.value = id;
      for (const [lang, template] of Object.entries(templates)) setCodeBlock(`qs-code-${lang}`, fill(template, lang, id));
      return true;
    };
    const syncUrl = (id: string) => {
      try {
        const url = new URL(location.href);
        if (id === qs.dataset.qsDefault) url.searchParams.delete('model'); else url.searchParams.set('model', id);
        history.replaceState(history.state, '', url);
      } catch { /* ignore */ }
    };

    const requested = new URLSearchParams(location.search).get('model');
    if (requested && !setModel(requested)) {
      showToast(`${requested} is not listed for this provider. Showing ${select?.value ?? 'the default model'}.`, 'info', 4000);
    }
    select?.addEventListener('change', () => { setModel(select.value); syncUrl(select.value); });

    const langButtons = Array.from(qs.querySelectorAll<HTMLButtonElement>('[data-qs-lang]'));
    langButtons.forEach(button => button.addEventListener('click', () => {
      const lang = button.dataset.qsLang;
      langButtons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
      qs.querySelectorAll<HTMLElement>('[data-qs-panel]').forEach(panel => { panel.hidden = panel.dataset.qsPanel !== lang; });
    }));

    document.querySelectorAll<HTMLButtonElement>('[data-pm-use]').forEach(button => button.addEventListener('click', () => {
      const id = button.dataset.pmUse ?? '';
      if (!setModel(id)) return;
      syncUrl(id);
      qs.scrollIntoView({ block: 'start' });
      qs.focus({ preventScroll: true });
      showToast(`Quick start now uses ${id}`);
    }));
  }

  /* ---------- Models: show all / first 8 ---------- */
  const modelsWrap = document.querySelector<HTMLElement>('.pm-models');
  const toggle = document.querySelector<HTMLButtonElement>('[data-pm-toggle]');
  if (modelsWrap && toggle) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(expanded));
      modelsWrap.toggleAttribute('data-collapsed', !expanded);
      toggle.textContent = expanded ? 'Show first 8' : toggle.dataset.labelMore ?? 'Show all models';
    });
  }

  /* ---------- Health: rendered only from a live snapshot ---------- */
  const health = document.getElementById('health');
  if (health) {
    const providerId = health.dataset.providerHealth;
    onStatus((data, info) => {
      const live = info.state === 'live';
      const probe = live ? data.providers.find(x => x.id === providerId) : undefined;
      const history: HealthStatus[] = probe?.history_90d ?? [];
      const summary = summarizeHistory(history);
      const hasHistory = live && summary.observed > 0;
      health.hidden = !live || (!hasHistory && !probe?.coverage);
      const historyBlock = health.querySelector<HTMLElement>('[data-health-history]');
      if (historyBlock) historyBlock.hidden = !hasHistory;

      document.querySelectorAll<HTMLElement>('[data-live-uptime]').forEach(node => {
        node.textContent = hasHistory && summary.percent !== null ? `${summary.percent.toFixed(1)}%` : '—';
      });
      const coverage = document.getElementById('history-coverage');
      if (coverage) coverage.textContent = hasHistory
        ? `${summary.healthy} healthy / ${summary.observed} observed days · ${90 - summary.observed} days without observations`
        : '';

      const strip = document.getElementById('health-strip');
      if (!strip) return;
      if (!hasHistory) { strip.replaceChildren(); return; }
      const days = history.slice(-90);
      const padded: HealthStatus[] = [...Array<HealthStatus>(90 - days.length).fill('unknown'), ...days];
      const anchor = data.last_checked ? new Date(data.last_checked) : new Date();
      const words: Record<HealthStatus, string> = { active: 'healthy', degraded: 'degraded', dead: 'unavailable', unknown: 'no data' };
      strip.replaceChildren(...padded.map((status, index) => {
        const bar = document.createElement('span');
        if (status !== 'unknown') bar.className = `h-${status}`;
        const day = new Date(anchor);
        day.setUTCDate(day.getUTCDate() - (89 - index));
        bar.title = `${day.toISOString().slice(0, 10)} UTC: ${words[status]}`;
        return bar;
      }));
      strip.setAttribute('aria-label', `Daily health over the last 90 days: ${summary.healthy} healthy of ${summary.observed} observed days`);
    });
  }
</script>
