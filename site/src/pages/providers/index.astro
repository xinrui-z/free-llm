---
// /providers was merged into the directory on "/". Old links (including /providers?q=… deep links) keep working:
//   dynamic mode (on-demand render): a real 301 to "/" with the query string preserved;
//   static mode: a tiny page that redirects with JS (query and hash preserved), falls back to a meta refresh
//   to "/" without JS, and points its canonical URL at "/" so search engines index the directory instead.
import { siteURL } from '../../lib/site-url';

if (import.meta.env.CATALOG_DYNAMIC) {
  return Astro.redirect(`/${Astro.url.search}`, 301);
}
const canonical = siteURL(Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Free LLM APIs: provider directory moved</title>
    <script is:inline>location.replace('/' + location.search + location.hash);</script>
    <meta http-equiv="refresh" content="0; url=/" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex" />
    <style>
      body { margin: 0; padding: 40px 16px; background: #0F172A; color: #CBD5E1; font: 14px/20px Inter, system-ui, sans-serif; }
      a { color: #22C55E; }
    </style>
  </head>
  <body>
    <p>The provider directory is now on the <a href="/">home page</a>.</p>
  </body>
</html>
