---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import SearchInput from '../../components/SearchInput.astro';
import Chip from '../../components/Chip.astro';
import ProviderLogo from '../../components/ProviderLogo.astro';
import NotPublished from '../../components/NotPublished.astro';
import Icon from '../../components/Icon.astro';
import { siteURL } from '../../lib/site-url';
import { getProviders } from '../../lib/providers';
import { contextToNumber, dateRange, daysSince, formatRate, formatTokens, isPricePageSynced, isStale, latestDate, liveCatalogSource, NO_CONTEXT_NOTE } from '../../lib/format';
import type { Provider, ProviderModel } from '../../data/providers';

const providers = getProviders(Astro.locals) as Provider[];

type FreeTier = 'yes' | 'other' | 'no';
interface PriceRow {
  provider: Provider;
  archived: boolean;
  model: ProviderModel;
  shortId: string;
  input: number;
  output: number | null;
  currency: string;
  source?: string;
  checkedAt?: string;
  validUntil?: string;
  free: FreeTier;
  // Price comes from the provider's live API (catalog sync job) or from its official pricing page (daily Price sync
  // workflow); its checkedAt is then the date the price last changed, not the date of the last check.
  autoSynced: boolean;
}

// One row per (provider, model) with a published per-token input price. Free-tier models that also have a
// paid rate come first; paid_models are paid-only SKUs of providers whose free models use other IDs.
const rows: PriceRow[] = [];
for (const p of providers) {
  const archived = p.status === 'archived';
  const live = liveCatalogSource(p), pageSynced = isPricePageSynced(p);
  const seen = new Set<string>();
  const add = (m: ProviderModel, isFreeModel: boolean) => {
    const pricing = m.pricing;
    if (!pricing || typeof pricing.input_per_million !== 'number' || !Number.isFinite(pricing.input_per_million) || seen.has(m.id)) return;
    seen.add(m.id);
    const output = typeof pricing.output_per_million === 'number' && Number.isFinite(pricing.output_per_million) ? pricing.output_per_million : null;
    rows.push({
      provider: p,
      archived,
      model: m,
      shortId: m.id.split('/').pop() || m.id,
      input: pricing.input_per_million,
      output,
      currency: String(pricing.currency || 'USD').trim().toUpperCase(),
      source: pricing.source_url,
      checkedAt: pricing.checked_at,
      validUntil: pricing.valid_until,
      free: archived ? 'no' : isFreeModel ? 'yes' : 'other',
      // A price recorded from another page stays manual even for an API-synced provider.
      autoSynced: pageSynced || (live !== null && (!live.url || !pricing.source_url || pricing.source_url === live.url)),
    });
  };
  for (const m of p.models ?? []) add(m, true);
  for (const m of p.paid_models ?? []) add(m, false);
}

// Prices in different currencies are never ranked against each other: USD first, then by code.
const currencies = [...new Set(rows.map(r => r.currency))].sort((a, b) => (a === 'USD' ? -1 : b === 'USD' ? 1 : a.localeCompare(b)));
const curRank = new Map(currencies.map((c, i) => [c, i]));
// Default order (matches the client default "Input price, low to high").
rows.sort((a, b) => curRank.get(a.currency)! - curRank.get(b.currency)! || a.input - b.input
  || (a.output ?? Infinity) - (b.output ?? Infinity) || a.shortId.localeCompare(b.shortId));

const pricedProviders = providers.filter(p => rows.some(r => r.provider.id === p.id))
  .sort((a, b) => Number(a.status === 'archived') - Number(b.status === 'archived') || a.name.localeCompare(b.name));
const activeRows = rows.filter(r => !r.archived).length;
const archivedRows = rows.length - activeRows;
const notShown = providers.filter(p => typeof p.pricing_note === 'string' && p.pricing_note.trim());
const notShownActive = notShown.filter(p => p.status !== 'archived').length;

// Freshness is evaluated at build time (static mode) or request time (dynamic mode). Manually maintained
// prices checked more than STALE_DAYS ago are marked "May be outdated"; auto-synced prices never are,
// because the sync jobs only move their date when the price itself changes.
const STALE_DAYS = 30;
const now = new Date();
const isRowStale = (r: PriceRow) => !r.autoSynced && isStale(r.checkedAt, now, STALE_DAYS);
// Rows carry different dates, so the header shows their range rather than one "last updated" date that
// would imply the whole table was refreshed then. Archived providers' prices are historical: they count
// only when no active provider has a price.
const datedRows = activeRows > 0 ? rows.filter(r => !r.archived) : rows;
const priceDates = dateRange(datedRows.map(r => r.checkedAt));
const pricesLastUpdated = latestDate(datedRows.map(r => r.checkedAt));
const staleActive = rows.filter(r => !r.archived && isRowStale(r)).length;

// Active free providers with no per-token price and no pricing note (typically newly onboarded free tiers)
// never appear in the table; say so instead of letting them look forgotten.
const unpricedFree = providers.filter(p => p.status === 'active' && !rows.some(r => r.provider.id === p.id) && !(typeof p.pricing_note === 'string' && p.pricing_note.trim()))
  .sort((a, b) => a.name.localeCompare(b.name));

const checkedLabel = (r: PriceRow) => r.autoSynced
  ? (r.checkedAt ? `Price unchanged since ${r.checkedAt}` : 'Synced automatically')
  : `Checked ${r.checkedAt ?? 'date unknown'}`;
const staleTip = (r: PriceRow) => {
  const age = daysSince(r.checkedAt, now);
  return age === null ? 'No check date recorded. Verify on the provider\'s pricing page.' : `Last checked ${age} days ago. Verify on the provider's pricing page.`;
};
const autoTip = 'Synced from the provider\'s live API on each catalog sync; the date shows when this price last changed.';
const pageTip = 'Read daily from the provider\'s official pricing page and applied automatically; the date shows when this price last changed.';
const search = (r: PriceRow) => `${r.model.id} ${r.model.name ?? ''} ${r.provider.name} ${r.provider.id}`.toLowerCase();
const promoTip = (d: string) => `Promotional price until ${d}. The standard rate applies after that.`;
const freeTitle = (r: PriceRow) => r.free === 'other' ? `${r.provider.name} has a free tier, but this model is paid only` : undefined;
const sourceTitle = (r: PriceRow) => (r.checkedAt ? `Source checked ${r.checkedAt}` : 'Price source');
const rowData = (r: PriceRow, i: number) => ({
  'data-pr-row': '',
  'data-provider': r.provider.id,
  'data-archived': r.archived ? 'true' : 'false',
  'data-stale': isRowStale(r) ? 'true' : 'false',
  'data-search': search(r),
  'data-input': String(r.input),
  'data-output': r.output == null ? '' : String(r.output),
  'data-context': String(contextToNumber(r.model.context_window)),
  'data-model': r.shortId.toLowerCase(),
  'data-cur': String(curRank.get(r.currency)),
  'data-order': String(i),
});

const SORTS = [
  ['input-asc', 'Input price, low to high'],
  ['input-desc', 'Input price, high to low'],
  ['output-asc', 'Output price, low to high'],
  ['output-desc', 'Output price, high to low'],
  ['context-desc', 'Context, largest first'],
  ['context-asc', 'Context, smallest first'],
  ['model-asc', 'Model ID, A to Z'],
  ['model-desc', 'Model ID, Z to A'],
] as const;
const sortHeaders = [
  { key: 'input', label: 'Input / 1M tokens', right: true },
  { key: 'output', label: 'Output / 1M tokens', right: true },
  { key: 'context', label: 'Context', right: true },
];
---

<Layout
  title="Paid LLM API Rates per 1M Tokens — After the Free Tier"
  description={`Paid per-token rates for ${activeRows} models from providers in the free LLM API directory, cheapest first, with each provider's official source.`}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Paid rates after the free tier",
    "description": "Paid per-token rates of free LLM API providers, from official pricing pages.",
    "url": siteURL(Astro.site, '/pricing/'),
    ...(pricesLastUpdated ? { "dateModified": pricesLastUpdated } : {}),
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL(Astro.site) },
        { "@type": "ListItem", "position": 2, "name": "Paid rates", "item": siteURL(Astro.site, '/pricing/') }
      ]
    }
  }}
>
  <PageHeader
    title="Paid rates after the free tier"
    lead="Paid reference prices for when free quotas run out: what the same providers charge per 1M tokens."
  >
    <Fragment slot="meta">
      <span id="pricing-freshness">{priceDates
        ? (priceDates.oldest === priceDates.newest
          ? <>Prices checked <span class="date">{priceDates.newest}</span></>
          : <>Price dates from <span class="date">{priceDates.oldest}</span> to <span class="date">{priceDates.newest}</span> (newest)</>)
        : <>Price dates unknown</>}</span>
      {staleActive > 0 && <> · <span class="num">{staleActive}</span> may be outdated</>}
      {' '}· Standard text rates from official pages · <a class="lnk" href="#pr-method">How prices are compared</a>
    </Fragment>
  </PageHeader>

  <div class="toolbar" id="pr-toolbar">
    <SearchInput id="pr-q" label="Search models" placeholder="Model ID or provider" param="q" />
    <label class="sr-only" for="pr-provider">Provider</label>
    <select class="select" id="pr-provider">
      <option value="">All providers</option>
      {pricedProviders.map(p => <option value={p.id} data-archived={p.status === 'archived' ? 'true' : 'false'}>{p.name}{p.status === 'archived' ? ' (archived)' : ''}</option>)}
    </select>
    {archivedRows > 0 && (
      <div class="chips" id="pr-chips">
        <Chip name="archived" label="Include archived providers" count={archivedRows} />
      </div>
    )}
    <label class="sr-only" for="pr-sort">Sort models</label>
    <select class="select" id="pr-sort">
      {SORTS.map(([value, label]) => <option value={value} selected={value === 'input-asc'}>{label}</option>)}
    </select>
    <span class="count" id="pr-count" aria-live="polite"><span class="num">{activeRows}</span> {activeRows === 1 ? 'model' : 'models'}</span>
  </div>

  <div class="only-md tblwrap" id="pr-table-wrap" hidden={activeRows === 0}>
    <table class="tbl" id="pricing-table">
      <caption class="sr-only">Paid per-token rates. Use the column buttons to sort.</caption>
      <thead>
        <tr>
          <th scope="col" data-sort-key="model" aria-sort="none">
            <button type="button" class="pr-sort" data-sort="model">Model ID<span class="pr-arrow" aria-hidden="true"></span></button>
          </th>
          <th scope="col">Provider</th>
          <th scope="col">Provider free tier</th>
          {sortHeaders.map(h => (
            <th scope="col" class="r" data-sort-key={h.key} aria-sort={h.key === 'input' ? 'ascending' : 'none'}>
              <button type="button" class="pr-sort" data-sort={h.key}>{h.label}<span class="pr-arrow" aria-hidden="true">{h.key === 'input' ? '↑' : ''}</span></button>
            </th>
          ))}
          <th scope="col">Price date</th>
          <th scope="col"><span class="sr-only">Source</span></th>
        </tr>
      </thead>
      <tbody id="pr-tbody">
        {rows.map((r, i) => {
          const input = formatRate(r.input, r.currency);
          const output = formatRate(r.output, r.currency);
          const ctx = formatTokens(r.model.context_window);
          return (
            <tr class:list={{ arch: r.archived }} {...rowData(r, i)} hidden={r.archived}>
              <td>
                <div class="pr-id">
                  <span class="mono" title={r.model.id}>{r.shortId}</span>
                  {r.validUntil && <button type="button" class="pill pill-accent pr-promo" data-tip={promoTip(r.validUntil)} aria-label={promoTip(r.validUntil)}>Promo to <span class="date">{r.validUntil}</span></button>}
                </div>
              </td>
              <td>
                <div class="pcell pr-prov">
                  <ProviderLogo provider={r.provider} size={16} />
                  <a class="pr-pname" href={`/providers/${r.provider.id}/`}>{r.provider.name}</a>
                  {r.archived && <span class="tag">Archived</span>}
                </div>
              </td>
              <td>
                {r.free === 'no'
                  ? <span class="muted">No</span>
                  : <span class="sec" title={freeTitle(r)}>{r.free === 'yes' ? 'Yes' : 'Yes, other models'}</span>}
              </td>
              <td class="r">{input ? <span class="num">{input}</span> : <NotPublished variant="dash" note="No input rate on the official pricing page." />}</td>
              <td class="r">{output ? <span class="num">{output}</span> : <NotPublished variant="dash" note="No output rate on the official pricing page." />}</td>
              <td class="r">{ctx ? <span class="num" title={ctx.title}>{ctx.text}</span> : <NotPublished variant="dash" note={NO_CONTEXT_NOTE} />}</td>
              <td class="pr-date">
                <div class="pr-date-cell">
                  {r.checkedAt ? <span class="date" title={checkedLabel(r)}>{r.checkedAt}</span> : <span class="vs vs-unknown" title="No check date recorded">Unknown</span>}
                  {r.autoSynced
                    ? <span class="pill pill-ok" title={isPricePageSynced(r.provider) ? pageTip : autoTip}>Auto-synced</span>
                    : isRowStale(r) ? <span class="pill pill-warn pr-stale" title={staleTip(r)}>May be outdated</span>
                    : <span class="pill pill-outline" title="Entered by hand from the official pricing page">Manual</span>}
                </div>
              </td>
              <td class="r pr-src">
                {r.source && <a class="lnk" href={r.source} target="_blank" rel="noopener noreferrer" title={sourceTitle(r)} aria-label={`Price source for ${r.model.id}${r.checkedAt ? `, checked ${r.checkedAt}` : ''}`}><Icon name="ext" /></a>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="only-sm srows" id="pr-list" hidden={activeRows === 0}>
    {rows.map((r, i) => {
      const input = formatRate(r.input, r.currency);
      const output = formatRate(r.output, r.currency);
      const ctx = formatTokens(r.model.context_window);
      return (
        <div class:list={['srow', { 'pr-arch': r.archived }]} {...rowData(r, i)} hidden={r.archived}>
          <div class="idline">
            <span class="mono" title={r.model.id}>{r.shortId}</span>
            {r.validUntil && <button type="button" class="pill pill-accent pr-promo" data-tip={promoTip(r.validUntil)} aria-label={promoTip(r.validUntil)}>Promo to <span class="date">{r.validUntil}</span></button>}
          </div>
          <div class="facts">
            <a class="sec pr-pname" href={`/providers/${r.provider.id}/`}>{r.provider.name}</a>
            {r.archived && <span class="tag">Archived</span>}
            <span class="sep">·</span>
            <span>{input ? <span class="num">{input}</span> : <NotPublished variant="dash" note="No input rate on the official pricing page." />} in</span>
            <span class="sep">·</span>
            <span>{output ? <span class="num">{output}</span> : <NotPublished variant="dash" note="No output rate on the official pricing page." />} out</span>
            {ctx && <><span class="sep">·</span><span class="num" title={ctx.title}>{ctx.text}</span></>}
          </div>
          <div class="caption">
            Free tier: {r.free === 'no'
              ? <span>No</span>
              : <span title={freeTitle(r)}>{r.free === 'yes' ? 'Yes' : 'Yes, other models'}</span>}
            {' · '}{r.source
              ? <a class="lnk" href={r.source} target="_blank" rel="noopener noreferrer" title={sourceTitle(r)}>{checkedLabel(r)} ↗</a>
              : <span>{checkedLabel(r)}</span>}
            {isRowStale(r) && <> <span class="pill pill-warn pr-stale" title={staleTip(r)}>May be outdated</span></>}
          </div>
        </div>
      );
    })}
  </div>

  <div class="empty" id="pr-empty" hidden={activeRows > 0}>
    <p id="pr-empty-text">{rows.length ? 'No priced model matches these filters.' : 'No provider in the catalog publishes a per-token paid rate.'}</p>
    <button class="btn" type="button" id="pr-clear" hidden={rows.length === 0}>Clear filters</button>
  </div>

  <section class="sect" id="pr-method" aria-labelledby="pr-method-h">
    <h2 class="h3" id="pr-method-h">How prices are compared</h2>
    <div class="pr-method">
      <p>Prices are the standard per-token rates for text input and output from each provider's official pricing page or API. Cached-input, batch, off-peak and volume discounts are not included. Promotional prices are marked and show their end date.</p>
      <p>Auto-synced prices are read automatically, either from the provider's live API on each catalog sync or once a day from its official pricing page, and their date shows when the price last changed. Manually maintained prices are updated only when someone re-checks the provider's pricing page; those checked more than {STALE_DAYS} days ago are marked "May be outdated". Always verify on the provider's site before budgeting.</p>
      <p>Only providers that still offer a free tier are listed by default. Archived providers no longer have a recurring free tier; turn on "Include archived providers" to compare their rates.{currencies.length > 1 && ` Prices in different currencies (${currencies.join(', ')}) are listed separately and never ranked against each other.`}</p>
    </div>
  </section>

  {(notShown.length > 0 || unpricedFree.length > 0) && (
    <section class="sect" id="pr-not-shown" aria-labelledby="pr-ns-h" hidden={notShownActive === 0 && unpricedFree.length === 0}>
      <h2 class="h3" id="pr-ns-h">Not shown: no per-token rate</h2>
      <div class="pr-ns-list">
        {unpricedFree.length > 0 && (
          <p class="sec" id="pr-unpriced">
            Free providers without published per-token prices:{' '}
            {unpricedFree.map((p, i) => <>{i > 0 && ', '}<a class="pr-ns-name" href={`/providers/${p.id}/`}>{p.name}</a></>)}.
            {' '}Their free quotas are on each provider page.
          </p>
        )}
        {notShown.map(p => (
          <p class="sec" data-ns-provider={p.id} data-archived={p.status === 'archived' ? 'true' : 'false'} hidden={p.status === 'archived'}>
            <a class="pr-ns-name" href={`/providers/${p.id}/`}>{p.name}</a>
            {p.status === 'archived' && <> <span class="tag">Archived</span></>}
            {' '}— {p.pricing_note}
          </p>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .pr-method { display: grid; gap: 8px; margin-top: 6px; max-width: 46rem; font-size: var(--fs-data); line-height: 20px; color: var(--text-secondary); }
  .pr-id { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .pr-id .mono { font-size: 12.5px; color: var(--text-primary); overflow-wrap: anywhere; }
  .tbl tr.arch .pr-id .mono { color: var(--text-muted); }
  .pr-prov { gap: 8px; }
  .pr-pname { white-space: nowrap; color: var(--text-secondary); }
  .pr-pname:hover { color: var(--brand); }
  .tbl tr.arch .pr-pname { color: var(--text-muted); }
  .pr-promo { cursor: help; flex-shrink: 0; }
  .pr-promo .date { font-size: inherit; }
  .pr-src { width: 40px; }
  .pr-date { white-space: nowrap; }
  .pr-date-cell { display: flex; align-items: center; gap: 8px; }
  .pr-date .date { font-size: var(--fs-caption); color: var(--text-secondary); }
  .pr-stale { cursor: help; }
  .pr-src a { display: inline-flex; padding: 4px; border-radius: var(--r-sm); color: var(--text-muted); }
  .pr-src a:hover { color: var(--brand); background: var(--bg-elevated); }
  /* Sortable headers: the button fills the cell so the whole header is the hit area. */
  .tbl th[data-sort-key] { padding: 0; }
  .tbl th.r .pr-sort { justify-content: flex-end; width: 100%; }
  .pr-sort { display: inline-flex; align-items: center; gap: 4px; padding: 8px 12px; font: inherit; color: inherit; cursor: pointer; white-space: nowrap; }
  .pr-sort:hover, th[aria-sort="ascending"] .pr-sort, th[aria-sort="descending"] .pr-sort { color: var(--text-primary); }
  .pr-arrow:empty { display: none; }
  .pr-arch .idline .mono, .pr-arch .facts .sec { color: var(--text-muted); }
  .pr-ns-list { display: grid; gap: 6px; margin-top: 8px; max-width: 46rem; font-size: var(--fs-data); }
  .pr-ns-name { font-weight: 500; color: var(--text-primary); }
  .pr-ns-name:hover { color: var(--brand); }
  @media (max-width: 767px) { #pr-toolbar .select { flex: 1 1 140px; } }
  #pr-empty[hidden], #pr-not-shown[hidden], #pr-table-wrap[hidden], #pr-list[hidden] { display: none; }
</style>

<script>
  import { chipEnabled, setChip } from '../../components/ui';

  type Key = 'input' | 'output' | 'context' | 'model';
  type Dir = 'asc' | 'desc';
  const DEFAULT_DIR: Record<Key, Dir> = { input: 'asc', output: 'asc', context: 'desc', model: 'asc' };

  const tbody = document.getElementById('pr-tbody');
  const list = document.getElementById('pr-list');
  const tableWrap = document.getElementById('pr-table-wrap');
  const providerSel = document.getElementById('pr-provider') as HTMLSelectElement;
  const sortSel = document.getElementById('pr-sort') as HTMLSelectElement;
  const archChip = document.querySelector<HTMLElement>('#pr-chips .chip[data-chip="archived"]');
  const count = document.getElementById('pr-count')!;
  const empty = document.getElementById('pr-empty')!;
  const emptyText = document.getElementById('pr-empty-text')!;
  const notShown = document.getElementById('pr-not-shown');
  const searchInput = document.getElementById('pr-q') as HTMLInputElement | null;
  const tableRows = tbody ? Array.from(tbody.querySelectorAll<HTMLElement>('[data-pr-row]')) : [];
  const listRows = list ? Array.from(list.querySelectorAll<HTMLElement>('[data-pr-row]')) : [];

  const params = new URL(location.href).searchParams;
  const state = {
    q: (params.get('q') ?? '').trim().toLowerCase(),
    provider: params.get('provider') ?? '',
    archived: params.get('archived') === '1',
    sort: params.get('sort') ?? 'input-asc',
  };
  if (!Array.from(providerSel.options).some(o => o.value === state.provider)) state.provider = '';
  if (!Array.from(sortSel.options).some(o => o.value === state.sort)) state.sort = 'input-asc';
  providerSel.value = state.provider;
  sortSel.value = state.sort;

  const selectedArchived = () => providerSel.selectedOptions[0]?.dataset.archived === 'true';
  const matchesBase = (el: HTMLElement) =>
    (!state.provider || el.dataset.provider === state.provider) && (!state.q || (el.dataset.search ?? '').includes(state.q));
  // Picking an archived provider in the select shows its rows even with the toggle off.
  const showArchived = () => state.archived || selectedArchived();
  const matches = (el: HTMLElement) => matchesBase(el) && (el.dataset.archived !== 'true' || showArchived());

  const num = (v: string | undefined) => (v == null || v === '' ? null : Number(v));
  function compare(key: Key, dir: Dir) {
    const sign = dir === 'asc' ? 1 : -1;
    return (a: HTMLElement, b: HTMLElement) => {
      if (key === 'model') return sign * (a.dataset.model ?? '').localeCompare(b.dataset.model ?? '') || Number(a.dataset.order) - Number(b.dataset.order);
      // Never rank prices across currencies.
      if (key !== 'context') { const cur = Number(a.dataset.cur) - Number(b.dataset.cur); if (cur) return cur; }
      let av = num(a.dataset[key]); let bv = num(b.dataset[key]);
      if (key === 'context') { if (av === -1) av = null; if (bv === -1) bv = null; }
      // Missing values always go last, whatever the direction.
      if (av == null || bv == null) return av == null && bv == null ? Number(a.dataset.order) - Number(b.dataset.order) : av == null ? 1 : -1;
      return sign * (av - bv) || Number(a.dataset.order) - Number(b.dataset.order);
    };
  }

  function syncHeaders(key: Key, dir: Dir) {
    document.querySelectorAll<HTMLElement>('#pricing-table th[data-sort-key]').forEach(th => {
      const active = th.dataset.sortKey === key;
      th.setAttribute('aria-sort', active ? (dir === 'asc' ? 'ascending' : 'descending') : 'none');
      const arrow = th.querySelector('.pr-arrow');
      if (arrow) arrow.textContent = active ? (dir === 'asc' ? '↑' : '↓') : '';
    });
  }

  function writeUrl() {
    const url = new URL(location.href);
    const set = (k: string, v: string) => { if (v) url.searchParams.set(k, v); else url.searchParams.delete(k); };
    set('provider', state.provider);
    set('archived', state.archived ? '1' : '');
    set('sort', state.sort === 'input-asc' ? '' : state.sort);
    history.replaceState(history.state, '', url);
  }

  function update() {
    const [key, dir] = state.sort.split('-') as [Key, Dir];
    const cmp = compare(key, dir);
    let visible = 0;
    for (const [container, rows] of [[tbody, tableRows], [list, listRows]] as const) {
      if (!container) continue;
      const sorted = [...rows].sort(cmp);
      container.append(...sorted);
      for (const el of sorted) el.hidden = !matches(el);
    }
    visible = tableRows.filter(el => !el.hidden).length;
    syncHeaders(key, dir);

    if (archChip) {
      const archivedCount = tableRows.filter(el => el.dataset.archived === 'true' && matchesBase(el)).length;
      setChip(archChip, { count: archivedCount, pressed: state.archived });
    }
    count.replaceChildren();
    const n = document.createElement('span');
    n.className = 'num';
    n.textContent = String(visible);
    count.append(n, visible === 1 ? ' model' : ' models');

    const none = visible === 0 && tableRows.length > 0;
    empty.hidden = !none;
    if (tableWrap) tableWrap.hidden = visible === 0;
    if (list) list.hidden = visible === 0;
    if (none) emptyText.textContent = state.q ? `No priced model matches “${state.q}”.` : 'No priced model matches these filters.';


    if (notShown) {
      // The unpriced-free-providers line is about the whole directory; hide it while one provider is picked.
      const unpriced = document.getElementById('pr-unpriced');
      if (unpriced) unpriced.hidden = !!state.provider;
      let shown = unpriced && !state.provider ? 1 : 0;
      notShown.querySelectorAll<HTMLElement>('[data-ns-provider]').forEach(p => {
        const ok = (!state.provider || p.dataset.nsProvider === state.provider) && (p.dataset.archived !== 'true' || showArchived());
        p.hidden = !ok;
        if (ok) shown++;
      });
      notShown.hidden = shown === 0;
    }
  }

  window.addEventListener('search-change', event => {
    const detail = (event as CustomEvent<{ id: string; value: string }>).detail;
    if (detail?.id !== 'pr-q') return;
    state.q = detail.value.toLowerCase();
    update();
  });
  providerSel.addEventListener('change', () => { state.provider = providerSel.value; writeUrl(); update(); });
  sortSel.addEventListener('change', () => { state.sort = sortSel.value; writeUrl(); update(); });
  archChip?.addEventListener('click', () => {
    if (!chipEnabled(archChip)) return;
    state.archived = !state.archived;
    writeUrl();
    update();
  });
  document.querySelectorAll<HTMLButtonElement>('#pricing-table .pr-sort').forEach(btn => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort as Key;
      const [curKey, curDir] = state.sort.split('-') as [Key, Dir];
      const dir: Dir = curKey === key ? (curDir === 'asc' ? 'desc' : 'asc') : DEFAULT_DIR[key];
      state.sort = `${key}-${dir}`;
      sortSel.value = state.sort;
      writeUrl();
      update();
    });
  });
  document.getElementById('pr-clear')?.addEventListener('click', () => {
    state.provider = '';
    providerSel.value = '';
    // SearchInput's own Clear button resets the box and ?q= and fires search-change.
    if (searchInput?.value) document.querySelector<HTMLButtonElement>('[data-search-clear="pr-q"]')?.click();
    state.q = '';
    writeUrl();
    update();
  });

  update();
</script>
