---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Chip from '../../components/Chip.astro';
import { siteURL } from '../../lib/site-url';
import { getProviders } from '../../lib/providers';
import { archiveDate } from '../../lib/format';
import changelog from '../../data/changelog.json';
import { buildView, type ChangeEntry, type ProviderIndex } from './_changelog-view';

const providers = getProviders(Astro.locals);
const entries = changelog as ChangeEntry[];

// Providers in the current catalog (static or live): names for links, and archive dates for the
// "Provider archived" suffix on their older entries.
const providerIndex: ProviderIndex = {};
for (const p of providers) {
  const archived = p.status === 'archived';
  providerIndex[p.id] = { name: p.name, archived, archivedOn: archived ? archiveDate(p, entries) : null };
}
const view = buildView(entries, providerIndex);
const TONE_DOT = { ok: 'd-active', warn: 'd-degraded', err: 'd-dead' } as const;
---

<Layout
  title="Free LLM API Changelog — Providers, Models and Archives"
  description="Changes to the free LLM API directory: providers added or archived, new free models and documentation reviews, grouped by date."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Free LLM API Changelog",
    "description": "Changes to the provider and model catalog of the free LLM API directory.",
    "url": siteURL(Astro.site, '/changelog/'),
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL(Astro.site) },
        { "@type": "ListItem", "position": 2, "name": "Changelog", "item": siteURL(Astro.site, '/changelog/') }
      ]
    }
  }}
>
  <PageHeader title="Changelog" lead="Changes to the provider and model catalog. Limits are re-verified by hand against official docs.">
  </PageHeader>

  <div id="changelog" data-providers={JSON.stringify(providerIndex)} data-signature={view.signature}>
    <div class="toolbar" id="cl-toolbar" hidden={view.total === 0}>
      <div class="chips" id="cl-chips" role="group" aria-label="Filter by change type">
        <Chip name="all" label="All" count={view.total} pressed />
        {view.chips.map(c => <Chip name={c.kind} label={c.label} count={c.count} />)}
      </div>
    </div>

    <div id="changelog-list">
      {view.days.map(day => (
        <section class="cl-day" data-date={day.date} aria-labelledby={`cl-d-${day.date}`}>
          <h2 class="chg-date cl-date" id={`cl-d-${day.date}`}><span class="date">{day.date}</span></h2>
          <div class="chg-list">
            {day.items.map(item => (
              <div class:list={['chg', 'changelog-entry', { old: item.old }]} data-kind={item.kind}>
                <span class:list={item.tone ? ['pill', `pill-${item.tone}`] : ['tag']}>{item.tone && <span class:list={['dot', TONE_DOT[item.tone]]} aria-hidden="true"></span>}{item.archivedTag && <span class="dot dot-sm d-unknown" aria-hidden="true"></span>}{item.tag}</span>
                <div class="min0">
                  <div class="chg-t">{item.title.map(part => part.href ? <a href={part.href}>{part.text}</a> : part.text)}{item.suffix && <> <span class="chg-suffix">{item.suffix}</span></>}</div>
                  {item.detail && <div class="chg-d">{item.detail}</div>}
                  {item.models && (
                    <div class="chg-d">{item.models.shown.join(', ')}{item.models.rest.length > 0 && <>{' '}<details class="inl"><summary>+{item.models.rest.length} more</summary><div class="mlist">{item.models.rest.map(m => <span class="tag tag-o">{m}</span>)}</div></details></>}</div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    <p class="empty" id="cl-empty" hidden={view.total > 0}>No changes recorded yet.</p>
  </div>
</Layout>

<style>
  #cl-toolbar[hidden], #cl-empty[hidden] { display: none; }
</style>

<style is:global>
  /* The first date group sits right under the chips. */
  #changelog-list .cl-day:first-child .cl-date { padding-top: 4px; }
  #changelog-list .cl-day[hidden] { display: none; }
  /* "+16 more" stays on the model line until it is opened. */
  #changelog-list .chg-d details.inl:not([open]) { display: inline; }
</style>

<script>
  import { loadChangelog } from '../../lib/changelog-client';
  import { chipEnabled, setChip } from '../../components/ui';
  import { buildView, type ChangeEntry, type Item, type ProviderIndex, type View } from './_changelog-view';

  const root = document.getElementById('changelog')!;
  const TONE_DOT = { ok: 'd-active', warn: 'd-degraded', err: 'd-dead' } as const;
  const list = document.getElementById('changelog-list')!;
  const chips = document.getElementById('cl-chips')!;
  let providers: ProviderIndex = {};
  try { providers = JSON.parse(root.dataset.providers || '{}'); } catch { /* links fall back to plain text */ }

  const params = new URL(location.href).searchParams;
  let kind = params.get('type') || 'all';

  function apply() {
    const chipEls = Array.from(chips.querySelectorAll<HTMLElement>('.chip'));
    if (!chipEls.some(c => c.dataset.chip === kind && chipEnabled(c))) kind = 'all';
    for (const c of chipEls) setChip(c, { pressed: c.dataset.chip === kind });
    list.querySelectorAll<HTMLElement>('.chg').forEach(el => { el.hidden = kind !== 'all' && el.dataset.kind !== kind; });
    list.querySelectorAll<HTMLElement>('.cl-day').forEach(day => { day.hidden = !day.querySelector('.chg:not([hidden])'); });
  }

  chips.addEventListener('click', event => {
    const chip = (event.target as Element).closest<HTMLElement>('.chip');
    if (!chip || !chipEnabled(chip)) return;
    kind = chip.dataset.chip === kind ? 'all' : chip.dataset.chip || 'all';
    const url = new URL(location.href);
    if (kind === 'all') url.searchParams.delete('type'); else url.searchParams.set('type', kind);
    history.replaceState(history.state, '', url);
    apply();
  });

  // Same structure as the server template above; every value is set as text.
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
    const node = document.createElement(tag);
    if (cls) node.className = cls;
    if (text != null) node.textContent = text;
    return node;
  };
  function chipEl(name: string, label: string, count: number) {
    const b = el('button', 'chip');
    b.type = 'button';
    b.dataset.chip = name;
    b.setAttribute('aria-pressed', 'false');
    const n = el('span', 'num', String(count));
    n.dataset.chipCount = '';
    b.append(label, ' ', n);
    return b;
  }
  function itemEl(item: Item) {
    const row = el('div', `chg changelog-entry${item.old ? ' old' : ''}`);
    row.dataset.kind = item.kind;
    const tag = el('span', item.tone ? `pill pill-${item.tone}` : 'tag');
    if (item.tone) { const d = el('span', `dot ${TONE_DOT[item.tone]}`); d.setAttribute('aria-hidden', 'true'); tag.append(d); }
    if (item.archivedTag) { const d = el('span', 'dot dot-sm d-unknown'); d.setAttribute('aria-hidden', 'true'); tag.append(d); }
    tag.append(item.tag);
    const body = el('div', 'min0');
    const title = el('div', 'chg-t');
    for (const part of item.title) {
      if (part.href) { const a = el('a', undefined, part.text); a.href = part.href; title.append(a); }
      else title.append(part.text);
    }
    if (item.suffix) title.append(' ', el('span', 'chg-suffix', item.suffix));
    body.append(title);
    if (item.detail) body.append(el('div', 'chg-d', item.detail));
    if (item.models) {
      const d = el('div', 'chg-d', item.models.shown.join(', '));
      if (item.models.rest.length) {
        const more = el('details', 'inl');
        more.append(el('summary', undefined, `+${item.models.rest.length} more`));
        const ml = el('div', 'mlist');
        for (const m of item.models.rest) ml.append(el('span', 'tag tag-o', m));
        more.append(ml);
        d.append(' ', more);
      }
      body.append(d);
    }
    row.append(tag, body);
    return row;
  }
  function render(view: View) {
    document.getElementById('cl-toolbar')!.hidden = view.total === 0;
    document.getElementById('cl-empty')!.hidden = view.total > 0;
    chips.replaceChildren(chipEl('all', 'All', view.total), ...view.chips.map(c => chipEl(c.kind, c.label, c.count)));
    list.replaceChildren(...view.days.map(day => {
      const sec = el('section', 'cl-day');
      sec.dataset.date = day.date;
      sec.setAttribute('aria-labelledby', `cl-d-${day.date}`);
      const h = el('h2', 'chg-date cl-date');
      h.id = `cl-d-${day.date}`;
      h.append(el('span', 'date', day.date));
      const items = el('div', 'chg-list');
      items.append(...day.items.map(itemEl));
      sec.append(h, items);
      return sec;
    }));
    root.dataset.signature = view.signature;
  }

  apply();
  // Newer entries from the status API, when configured; otherwise the bundled changelog (same as the server render).
  loadChangelog().then((data: ChangeEntry[]) => {
    const view = buildView(data, providers);
    if (view.signature === root.dataset.signature) return;
    render(view);
    apply();
  }).catch(() => { /* keep the server-rendered changelog */ });
</script>
