---
import Layout from '../../layouts/Layout.astro';
import { siteURL } from '../../lib/site-url';
import { getProviders } from '../../lib/providers';
const providers = getProviders(Astro.locals);

import changelog from '../../data/changelog.json';

// Filter options come from the changelog itself (plus the current catalog),
// so entries for removed or archived providers stay filterable.
const providerNames = new Map<string, string>();
for (const entry of changelog as { provider_id?: string; provider_name?: string }[]) {
  if (entry.provider_id && !providerNames.has(entry.provider_id)) providerNames.set(entry.provider_id, entry.provider_name || entry.provider_id);
}
for (const p of providers) providerNames.set(p.id, p.name);
const providerOptions = [...providerNames].sort((a, b) => a[1].localeCompare(b[1]));
---

<Layout
  title="Free LLM API Changelog — Outages, Recoveries & Updates"
  description="Full history of free LLM API status changes: outages, recoveries, new models and rate limit updates across OpenRouter, Groq, AIHubMix, Cohere and more."
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Free LLM API Changelog",
    "description": "Historical log of status changes, outages, recoveries, and model updates across free LLM API providers.",
    "url": siteURL(Astro.site, '/changelog/'),
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteURL(Astro.site) },
        { "@type": "ListItem", "position": 2, "name": "Changelog", "item": siteURL(Astro.site, '/changelog/') }
      ]
    }
  }}
>
  <div class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <!-- Page header -->
    <div class="pt-8 pb-6">
      <div class="flex items-start justify-between flex-wrap gap-4">
        <div>
          <h1 class="text-2xl font-bold text-white mb-1">Changelog</h1>
          <p class="text-slate-400 text-sm">Automatically tracks status changes across all free LLM APIs</p>
        </div>
      </div>
    </div>

    <!-- Filter bar -->
    <div class="flex flex-wrap items-center gap-2 mb-6">
      <span class="text-sm text-slate-500">Filter:</span>
      <select
        id="provider-filter" aria-label="Filter by provider"
        class="bg-slate-800 border border-slate-700 text-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-green-500 cursor-pointer"
      >
        <option value="">All Providers</option>
        {providerOptions.map(([id, name]) => <option value={id}>{name}</option>)}
      </select>
      <select
        id="type-filter" aria-label="Filter by change type"
        class="bg-slate-800 border border-slate-700 text-slate-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-green-500 cursor-pointer"
      >
        <option value="">All Types</option>
        <option value="outage">Outage</option>
        <option value="recovery">Recovery</option>
        <option value="degraded">Degraded</option>
        <option value="status_change">Status Change</option>
        <option value="provider_added">Provider Added</option>
        <option value="model_added">Model Added</option>
        <option value="model_removed">Model Removed</option>
        <option value="provider_removed">Provider Removed</option>
        <option value="rate_limit_change">Rate Limit Change</option>
      </select>
    </div>

    <!-- Timeline (rendered client-side) -->
    <div id="changelog-list">
      {[...changelog].sort((a, b) => b.date.localeCompare(a.date)).map(entry => <article class="border-l-2 border-slate-700 pl-5 py-3 mb-3"><p class="text-xs text-slate-400">{entry.date}</p><h2 class="text-sm text-slate-200">{entry.title}</h2><p class="text-sm text-slate-400">{entry.description}</p></article>)}
    </div>

    <div id="changelog-footer" class="hidden pb-12 text-center text-sm text-slate-400"></div>
  </div>
</Layout>

<script>
  import { loadChangelog, renderChangelog, type ChangeEntry } from '../../lib/changelog-client';
  const list = document.getElementById('changelog-list');
  const provider = document.getElementById('provider-filter') as HTMLSelectElement;
  const type = document.getElementById('type-filter') as HTMLSelectElement;
  let entries: ChangeEntry[] = [];
  function render() {
    const filtered = entries.filter(e => (!provider.value || e.provider_id === provider.value) && (!type.value || e.type === type.value));
    if (list) renderChangelog(list, filtered);
    const footer = document.getElementById('changelog-footer');
    if (footer) { footer.textContent = `${filtered.length} of ${entries.length} recent entries`; footer.classList.remove('hidden'); }
  }
  // Live entries may mention providers missing from the bundled list.
  function addProviderOptions(data: ChangeEntry[]) {
    const known = new Set(Array.from(provider.options, o => o.value));
    const added = new Map<string, string>();
    for (const e of data) if (e.provider_id && !known.has(e.provider_id) && !added.has(e.provider_id)) added.set(e.provider_id, e.provider_name || e.provider_id);
    for (const [id, name] of added) provider.add(new Option(name, id));
  }
  provider.addEventListener('change', render);
  type.addEventListener('change', render);
  loadChangelog().then(data => { entries = data; addProviderOptions(data); render(); });
</script>
