---
// "/" — the single provider directory (replaces the old home table and /providers).
// Order: PageHeader, StatusNotice, Quickest first call, All free providers (toolbar + ProviderTable),
// Archived providers (collapsed), Recent changes. Renders complete without JS or the status API;
// the client script only filters/sorts the SSR rows and swaps in the changelog API's entries.
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import StatusNotice from '../components/StatusNotice.astro';
import StatusSlot from '../components/StatusSlot.astro';
import ProviderLogo from '../components/ProviderLogo.astro';
import LimitFacts from '../components/LimitFacts.astro';
import CopyField from '../components/CopyField.astro';
import ProviderTable from '../components/ProviderTable.astro';
import SearchInput from '../components/SearchInput.astro';
import Chip from '../components/Chip.astro';
import Fold from '../components/Fold.astro';
import { compareByTpm, SORT_CAPTIONS } from '../components/provider-table';
import { accessLine, archiveDate, formatCount, formatDate, hasVision, limitsOf } from '../lib/format';
import { siteURL } from '../lib/site-url';
import { getProviders } from '../lib/providers';
import changelog from '../data/changelog.json';
import { recentChanges } from './_recent-changes';

const catalog = getProviders(Astro.locals);
// Catalog order is the order getProviders returns (data/_order.json, or the live catalog's order).
const active = catalog.filter(p => p.status === 'active');
const archived = catalog.filter(p => p.status === 'archived');

// Quickest first call: active providers with any published request limit first (tokens per minute, then requests per minute),
// then catalog order. Archived providers are never candidates.
const picks = active
  .map((p, order) => ({ p, order, L: limitsOf(p) }))
  .sort((a, b) => Number(b.L.published) - Number(a.L.published)
    || (a.L.published ? compareByTpm({ tpm: a.L.tpm, rpm: a.L.rpm, order: a.order }, { tpm: b.L.tpm, rpm: b.L.rpm, order: b.order }) : a.order - b.order))
  .slice(0, 3)
  .map(x => x.p);

const verified = active.map(p => formatDate(p.last_verified)).filter((d): d is string => !!d).sort();
const firstVerified = verified[0];
const lastVerified = verified[verified.length - 1];

const total = active.length;
const counts = {
  pub: active.filter(p => limitsOf(p).published).length,
  vision: active.filter(p => hasVision(p)).length,
  oai: active.filter(p => (p.tags ?? []).includes('openai-compatible')).length,
};

const recent = recentChanges(changelog, catalog);
const linkable = JSON.stringify(catalog.map(p => ({ id: p.id, name: p.name })));

const title = 'Free LLM APIs — Providers, Rate Limits and Live Status';
const description = `${total} LLM API providers with a recurring free tier: documented request limits, free models and base URLs, with live health checks.`;
const home = siteURL(Astro.site);
---

<Layout
  title={title}
  description={description}
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Free LLM APIs',
      url: home,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Free LLM APIs you can call today',
      url: home,
      description,
      ...(lastVerified ? { dateModified: lastVerified } : {}),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: total,
        itemListElement: active.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: p.name,
          url: siteURL(Astro.site, `/providers/${encodeURIComponent(p.id)}/`),
        })),
      },
    },
  ]}
>
  <PageHeader
    title="Free LLM APIs you can call today"
    lead="Providers with a recurring free tier. Limits come from each provider's official documentation."
  >
    <Fragment slot="meta">
      <span class="num">{formatCount(total)}</span> {total === 1 ? 'provider' : 'providers'}
      {archived.length > 0 && <> · <a class="meta-a" href="#archived"><span class="num">{formatCount(archived.length)}</span> archived</a></>}
      {firstVerified && (firstVerified === lastVerified
        ? <> · limits verified <span class="date">{firstVerified}</span></>
        : <> · limits verified <span class="date">{firstVerified}</span> to <span class="date">{lastVerified}</span></>)}
    </Fragment>
  </PageHeader>

  <StatusNotice />

  {picks.length > 0 && (
    <section class="sect" aria-labelledby="picks-h">
      <div class="sect-head">
        <h2 class="h2" id="picks-h">Quickest first call</h2>
        <span class="caption">Chosen by rule: providers with a published request limit first (tokens per minute, then requests per minute), then catalog order.</span>
      </div>
      <div class="picks">
        {picks.map(p => {
          const key = p.signup_url || p.website_url;
          return (
            <article class="pick" aria-labelledby={`pick-${p.id}`} data-pick={p.id}>
              <div class="pick-h">
                <StatusSlot providerId={p.id} />
                <ProviderLogo provider={p} size={24} />
                <a id={`pick-${p.id}`} href={`/providers/${p.id}/`}>{p.name}</a>
              </div>
              <LimitFacts provider={p} size="compact" />
              <div class="access">{accessLine(p)} · <span class="num">{formatCount(p.models.length)}</span> free {p.models.length === 1 ? 'model' : 'models'}</div>
              <CopyField label="Base URL" value={p.base_url} id={`pk-${p.id}`} toast="Base URL copied" />
              <div class="pick-acts">
                {key && <a class="btn btn-p" href={key} target="_blank" rel="noopener noreferrer">Get API key ↗</a>}
                <a class="btn btn-t" href={`/providers/${p.id}/#quick-start`}>Quick start →</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  )}

  <section class="sect" aria-labelledby="dir-h">
    <div class="sect-head">
      <h2 class="h2" id="dir-h">All free providers</h2>
      <span class="caption" id="dir-caption">{SORT_CAPTIONS.tpm}</span>
    </div>
    <div class="toolbar">
      <SearchInput id="dir-q" label="Search providers" placeholder="Search provider or model ID" param="q" />
      <div class="chips" id="dir-chips" role="group" aria-label="Filter providers">
        <Chip name="pub" label="Published rate limit" count={counts.pub} hidden={counts.pub === total} />
        <Chip name="vision" label="Vision" count={counts.vision} hidden={counts.vision === total} />
        <Chip name="oai" label="OpenAI-compatible" count={counts.oai} hidden={counts.oai === total} />
        <Chip name="st-up" label="Up" count={0} data-live-only="" />
        <Chip name="st-issues" label="Issues" count={0} data-live-only="" />
      </div>
      <label class="sr-only" for="dir-sort">Sort providers</label>
      <select class="select" id="dir-sort">
        <option value="tpm">Sort: Published rate limit</option>
        <option value="name">Sort: Name</option>
        <option value="models">Sort: Most models</option>
      </select>
      <span class="count" id="dir-count" aria-live="polite"><span class="num">{total}</span> of <span class="num">{total}</span></span>
    </div>
    {total > 0
      ? <ProviderTable providers={active} id="provider-table" />
      : <div class="empty"><p>No provider currently offers a recurring free tier in this catalog.</p></div>}
    <div class="empty" id="dir-empty" hidden>
      <p id="dir-empty-text">No provider matches these filters.</p>
      <button class="btn" type="button" id="dir-empty-clear">Clear filters</button>
    </div>
  </section>

  {archived.length > 0 && (
    <section class="sect" aria-label="Archived providers">
      <Fold id="archived" summary={`Archived providers (${archived.length})`} note="— they no longer offer a recurring free tier">
        <div class="arch-list">
          {archived.map(p => {
            const date = archiveDate(p, changelog);
            const why = p.archive_reason ?? '';
            return (
              <div class="arch-row">
                <a href={`/providers/${p.id}/`}>{p.name}</a>
                <span class="text-xs">{date ? <>Archived <span class="date">{date}</span></> : 'Archived'}</span>
                <span class="why" title={why || undefined}>{why}</span>
              </div>
            );
          })}
        </div>
      </Fold>
    </section>
  )}

  <section class="sect" aria-labelledby="rc-h">
    <div class="sect-head">
      <h2 class="h2" id="rc-h">Recent changes</h2>
      <a class="lnk text-sm" href="/changelog/">Full changelog →</a>
    </div>
    <div id="recent-changes" data-providers={linkable}>
      {recent.length === 0 && <p class="muted text-sm">No changes recorded yet.</p>}
      {recent.map(day => (
        <>
          <div class="chg-date"><span class="date">{day.date}</span></div>
          <div class="chg-list">
            {day.items.map(item => (
              <div class="chg" data-kind={item.type}>
                <span class="tag">{item.archived && <span class="dot dot-sm d-dead" aria-hidden="true"></span>}{item.tag}</span>
                <div class="chg-t">{item.parts.map(part => typeof part === 'string' ? part : part.href ? <a href={part.href}>{part.name}</a> : part.name)}</div>
              </div>
            ))}
          </div>
        </>
      ))}
    </div>
  </section>
</Layout>

<style>
  .access :global(.num) { color: inherit; font-size: 12px; }
  .meta-a { color: inherit; }
  .meta-a:hover { color: var(--brand); }
</style>

<script>
  import { arrangeProviderTable, SORT_CAPTIONS, type ProviderSort } from '../components/provider-table';
  import { chipEnabled, setChip } from '../components/ui';
  import { getStatusInfo, onStatus } from '../lib/status-client';
  import { loadChangelog } from '../lib/changelog-client';
  import { recentChanges, type RecentDay } from './_recent-changes';

  type StatusFilter = '' | 'up' | 'issues';
  interface Filters { q: string; pub: boolean; vision: boolean; oai: boolean; st: StatusFilter }

  const table = document.getElementById('provider-table');
  const select = document.getElementById('dir-sort') as HTMLSelectElement | null;
  const chips = document.getElementById('dir-chips');
  const count = document.getElementById('dir-count');
  const caption = document.getElementById('dir-caption');
  const empty = document.getElementById('dir-empty');
  const emptyText = document.getElementById('dir-empty-text');
  const emptyClear = document.getElementById('dir-empty-clear');

  const f: Filters = { q: (new URL(location.href).searchParams.get('q') ?? '').trim(), pub: false, vision: false, oai: false, st: '' };
  let sort: ProviderSort = 'tpm';
  const isLive = () => getStatusInfo().state === 'live';

  // The desktop rows carry every data-* hook; the mobile cards are a copy of the same data.
  const rows = () => Array.from(table?.querySelectorAll<HTMLElement>('[data-pt-body] > [data-pt-row]') ?? []);

  function matches(row: HTMLElement, x: Filters) {
    const d = row.dataset;
    if (x.q && !(d.search ?? '').includes(x.q.toLowerCase())) return false;
    if (x.pub && d.pub !== 'true') return false;
    if (x.vision && d.vision !== 'true') return false;
    if (x.oai && d.oai !== 'true') return false;
    if (x.st && isLive()) {
      const s = d.status ?? 'unknown';
      if (x.st === 'up' && s !== 'active') return false;
      if (x.st === 'issues' && s !== 'degraded' && s !== 'dead') return false;
    }
    return true;
  }
  const countWith = (over: Partial<Filters>) => { const x = { ...f, ...over }; return rows().filter(r => matches(r, x)).length; };

  const CHIPS: Record<string, { pressed: () => boolean; over: Partial<Filters>; toggle: () => void }> = {
    pub: { pressed: () => f.pub, over: { pub: true }, toggle: () => { f.pub = !f.pub; } },
    vision: { pressed: () => f.vision, over: { vision: true }, toggle: () => { f.vision = !f.vision; } },
    oai: { pressed: () => f.oai, over: { oai: true }, toggle: () => { f.oai = !f.oai; } },
    'st-up': { pressed: () => f.st === 'up', over: { st: 'up' }, toggle: () => { f.st = f.st === 'up' ? '' : 'up'; } },
    'st-issues': { pressed: () => f.st === 'issues', over: { st: 'issues' }, toggle: () => { f.st = f.st === 'issues' ? '' : 'issues'; } },
  };

  function syncLatencyOption() {
    if (!select) return;
    const info = getStatusInfo();
    const want = info.state === 'live' && info.hasLatency;
    let option = select.querySelector<HTMLOptionElement>('option[value="latency"]');
    if (want && !option) {
      option = document.createElement('option');
      option.value = 'latency';
      option.textContent = 'Sort: Latency';
      select.append(option);
    } else if (!want && option) {
      option.remove();
      if (sort === 'latency') sort = 'tpm';
    }
    select.value = sort;
  }

  function setCount(visible: number, totalRows: number) {
    if (!count) return;
    const a = document.createElement('span'); a.className = 'num'; a.textContent = String(visible);
    const b = document.createElement('span'); b.className = 'num'; b.textContent = String(totalRows);
    count.replaceChildren(a, ' of ', b);
  }

  function update() {
    if (!table) return;
    if (!isLive()) f.st = '';
    syncLatencyOption();
    const all = rows();
    const total = countWith({});
    chips?.querySelectorAll<HTMLElement>('[data-chip]').forEach(chip => {
      const def = CHIPS[chip.dataset.chip ?? ''];
      if (def) setChip(chip, { count: countWith(def.over), pressed: def.pressed(), hideIfTotal: total });
    });
    const visible = arrangeProviderTable(table, { match: row => matches(row, f), sort });
    setCount(visible, all.length);
    if (caption) caption.textContent = SORT_CAPTIONS[sort];
    table.hidden = visible === 0;
    if (empty && emptyText && emptyClear) {
      empty.hidden = visible !== 0;
      emptyText.textContent = f.q ? `No provider matches “${f.q}”. Try a model family like qwen or gemma.` : 'No provider matches these filters.';
      emptyClear.textContent = f.q ? 'Clear search' : 'Clear filters';
    }
  }

  chips?.addEventListener('click', event => {
    const chip = (event.target as HTMLElement).closest<HTMLElement>('[data-chip]');
    if (!chip || !chipEnabled(chip)) return;
    CHIPS[chip.dataset.chip ?? '']?.toggle();
    update();
  });
  select?.addEventListener('change', () => { sort = (select.value as ProviderSort) || 'tpm'; update(); });
  window.addEventListener('search-change', event => {
    const detail = (event as CustomEvent<{ id: string; value: string }>).detail;
    if (detail?.id !== 'dir-q') return;
    f.q = detail.value;
    update();
  });
  emptyClear?.addEventListener('click', () => {
    if (f.q) {
      document.querySelector<HTMLButtonElement>('[data-search-clear="dir-q"]')?.click();
      return;
    }
    f.pub = f.vision = f.oai = false;
    f.st = '';
    update();
  });
  onStatus(() => update());
  update();

  // /#archived (meta line link, old links) opens the collapsed list.
  const openArchived = () => {
    const fold = document.getElementById('archived') as HTMLDetailsElement | null;
    if (fold && location.hash === '#archived') fold.open = true;
  };
  window.addEventListener('hashchange', openArchived);
  openArchived();

  // Recent changes: the changelog API when configured, else the bundled changelog. Text only.
  function renderRecent(container: HTMLElement, days: RecentDay[]) {
    const node = (tag: string, className: string, text?: string) => {
      const n = document.createElement(tag);
      n.className = className;
      if (text !== undefined) n.textContent = text;
      return n;
    };
    container.replaceChildren();
    if (!days.length) { container.append(node('p', 'muted text-sm', 'No changes recorded yet.')); return; }
    for (const day of days) {
      const head = node('div', 'chg-date');
      head.append(node('span', 'date', day.date));
      const list = node('div', 'chg-list');
      for (const item of day.items) {
        const row = node('div', 'chg');
        row.dataset.kind = item.type;
        const tag = node('span', 'tag');
        if (item.archived) { const dot = node('span', 'dot dot-sm d-dead'); dot.setAttribute('aria-hidden', 'true'); tag.append(dot); }
        tag.append(item.tag);
        const text = node('div', 'chg-t');
        for (const part of item.parts) {
          if (typeof part === 'string') text.append(part);
          else if (part.href) { const a = node('a', '', part.name) as HTMLAnchorElement; a.href = part.href; text.append(a); }
          else text.append(part.name);
        }
        row.append(tag, text);
        list.append(row);
      }
      container.append(head, list);
    }
  }
  const recent = document.getElementById('recent-changes');
  if (recent) {
    let providers: { id: string; name: string }[] = [];
    try { providers = JSON.parse(recent.dataset.providers ?? '[]'); } catch { /* links fall back to plain names */ }
    loadChangelog(200).then(entries => renderRecent(recent, recentChanges(entries, providers))).catch(() => { /* keep the server-rendered list */ });
  }
</script>
