---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Toast from '../components/Toast.astro';
import { getProviders } from '../lib/providers';
import { DEFAULT_SITE, siteURL } from '../lib/site-url';
const providers = getProviders(Astro.locals);
const REPO = 'https://github.com/xinrui-z/free-llm';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: object | object[];
  /** Error pages: keep out of search results; no canonical or og:url (the URL is not a real page). */
  noindex?: boolean;
}

const {
  title = 'Free LLM APIs — Real-time Status',
  description = 'Real-time monitoring of free LLM API availability. Track OpenRouter, AIHubMix, BigModel and more — find free LLM APIs that are actually working.',
  ogImage = '/og-image.png',
  jsonLd,
  noindex = false
} = Astro.props;

const siteBase = Astro.site || DEFAULT_SITE;
// Canonical/og:url always use the trailing-slash form listed in the sitemap, however the request was spelled.
const canonicalURL = siteURL(Astro.site, Astro.url.pathname);
const ogImageURL = new URL(ogImage, siteBase).href;
const catalog = Astro.locals.catalog;
const catalogNotice = !catalog?.unavailable ? null
  : catalog.stale ? 'Live catalog is temporarily unavailable. Showing the last confirmed live directory; it may be out of date.'
  : 'Live catalog is temporarily unavailable. Showing the snapshot bundled at build time; it may be stale and recent additions may be missing.';
---

<!doctype html>
<html lang="en" data-provider-ids={providers.filter(p => p.status === 'active').map(p => p.id).join(',')}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {ogImage === '/og-image.png' && <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>}
    <meta property="og:image:alt" content="Free LLM APIs" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Z_250508" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Theme: dark by default, light from the OS preference or a saved choice. Set before paint (no flash). -->
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0B0C0E" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFFFF" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') {
          document.documentElement.dataset.theme = t;
          // A chosen theme overrides the OS preference for the browser bar colour too.
          document.querySelectorAll('meta[name="theme-color"]').forEach(m => m.setAttribute('content', t === 'light' ? '#FFFFFF' : '#0B0C0E'));
        }
      } catch {}
    </script>

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
    )}
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-md focus:px-3 focus:py-2 focus:text-sm skip-link">Skip to content</a>
    <NavBar />
    <main id="main" tabindex="-1" class="max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
      {catalogNotice && (
        <p role="status" class="catalog-notice">
          <span class="dot d-unknown" aria-hidden="true"></span><span>{catalogNotice}</span>
        </p>
      )}
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-in max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
        <div>
          <h2>Free LLM APIs</h2>
          <p>A directory of LLM APIs with a recurring free tier, with limits linked to each provider's own documentation.</p>
          <p class="mt-2.5">
            <a class="lnk" href="https://opensource.org/licenses/MIT" target="_blank" rel="noopener noreferrer">MIT License</a>{' · '}© {new Date().getFullYear()}
          </p>
        </div>
        <nav aria-label="Footer">
          <h2>Pages</h2>
          <ul>
            <li><a class="lnk" href="/">Providers</a></li>
            <li><a class="lnk" href="/models/">Models</a></li>
            <li><a class="lnk" href="/pricing/">Paid rates</a></li>
            <li><a class="lnk" href="/configs/">Tools</a></li>
            <li><a class="lnk" href="/changelog/">Changelog</a></li>
          </ul>
        </nav>
        <div>
          <h2>How this data works</h2>
          <p>Limits come from each provider's official docs and are re-checked by hand; each value shows its source and date. Health is measured by scheduled API probes; when probes are unavailable we say so instead of guessing.</p>
          <ul class="mt-2.5">
            <li><a class="lnk" href={`${REPO}/blob/main/docs/automatic-catalog.md`} target="_blank" rel="noopener noreferrer">Methodology ↗</a></li>
            <li><a class="lnk" href={REPO} target="_blank" rel="noopener noreferrer">Data repository ↗</a></li>
            <li><a class="lnk" href="/changelog.json">Changelog feed (JSON)</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <div id="tip" role="tooltip" hidden></div>
    <Toast />

    <script>
      import { initUI } from '../components/ui';
      import { startStatus } from '../lib/status-client';
      initUI();
      startStatus();
    </script>
  </body>
</html>
