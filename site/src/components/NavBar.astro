---
// Sticky top nav. Providers is active on / and /providers/*. Below 640px: row 1 = brand + GitHub,
// row 2 = the links (incl. Paid rates) in one horizontally scrollable row with a right fade.
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const links = [
  { href: '/', label: 'Providers', active: path === '/' || path === '/providers' || path.startsWith('/providers/') },
  { href: '/models', label: 'Models', active: path === '/models' || path.startsWith('/models/') },
  { href: '/configs', label: 'Tools', active: path === '/configs' || path.startsWith('/configs/') },
  { href: '/changelog', label: 'Changelog', active: path === '/changelog' || path.startsWith('/changelog/') },
];
const paidActive = path === '/pricing' || path.startsWith('/pricing/');
---
<header class="nav" id="navbar">
  <div class="nav-in max-w-7xl mx-auto px-4 md:px-6 lg:px-8">
    <a class="brand-link" href="/" aria-label="Free LLM APIs, all providers">
      <img src="/logo.png" alt="" width="24" height="24" class="invert" />
      <span>Free LLM APIs</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      {links.map(l => <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>)}
      <a href="/pricing" class="m-only" aria-current={paidActive ? 'page' : undefined}>Paid rates</a>
    </nav>
    <div class="nav-right">
      <a href="/pricing" class="paid-link" aria-current={paidActive ? 'page' : undefined}>Paid rates</a>
      <a class="gh" href="https://github.com/xinrui-z/free-llm" target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
        <Icon name="github" size={18} />
      </a>
    </div>
  </div>
</header>
