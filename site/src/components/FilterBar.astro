---
interface Props { searchPlaceholder?: string; }
const { searchPlaceholder = 'Search provider name or model...' } = Astro.props;
---
<div class="bg-slate-800/30 border border-slate-700/50 rounded-xl p-4" id="filter-bar">
  <label for="search-input" class="sr-only">Search providers or models</label>
  <div class="relative">
    <input type="search" id="search-input" placeholder={searchPlaceholder} autocomplete="off"
      class="w-full bg-slate-900 border border-slate-700 rounded-lg pl-3 pr-20 py-2 text-sm text-slate-300 placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500" />
    <button id="clear-search" type="button" aria-label="Clear search" class="hidden absolute inset-y-0 right-0 px-3 text-sm text-slate-300 hover:text-white">Clear</button>
  </div>
</div>
<script>
  const input = document.getElementById('search-input') as HTMLInputElement;
  const clear = document.getElementById('clear-search') as HTMLButtonElement;
  let timer: ReturnType<typeof setTimeout>;
  function notify() {
    clear.classList.toggle('hidden', !input.value);
    window.dispatchEvent(new CustomEvent('search-change'));
  }
  function restore() {
    clearTimeout(timer);
    input.value = new URL(location.href).searchParams.get('q') ?? '';
    notify();
  }
  function update() {
    const url = new URL(location.href);
    if (input.value.trim()) url.searchParams.set('q', input.value); else url.searchParams.delete('q');
    history.replaceState({}, '', url);
    notify();
  }
  input.addEventListener('input', () => {
    clearTimeout(timer);
    clear.classList.toggle('hidden', !input.value);
    timer = setTimeout(update, 200);
  });
  clear.addEventListener('click', () => {
    clearTimeout(timer);
    input.value = '';
    update();
    input.focus();
  });
  window.addEventListener('popstate', restore);
  restore();
</script>
