---
// One fact-sheet unit for request limits + context (+ model count), in three sizes:
//   inline  — ".facts" line for rows/cards: "30 RPM · 1,000 RPD · 3 models · 128K context" (safe inside <a>)
//   compact — 3-cell grid for pick cards: Requests/min · Requests/day · Max context
//   large   — 4-cell grid for the provider page: Requests/min · Requests/day · Max context · Free models
// Missing values follow the Not published convention; nothing is ever filled in.
import NotPublished from './NotPublished.astro';
import { formatCount, formatTokens, limitsOf, maxContext, NO_CONTEXT_NOTE } from '../lib/format';
interface Props {
  provider: { rpm?: number | null; rpd?: number | null; quota_note?: string | null; context_window?: unknown; models?: { context_window?: unknown }[] };
  size?: 'inline' | 'compact' | 'large';
  class?: string;
}
const { provider, size = 'inline', class: className } = Astro.props;
const L = limitsOf(provider);
const ctx = formatTokens(maxContext(provider));
const models = provider.models?.length ?? 0;
const rpm = formatCount(L.rpm), rpd = formatCount(L.rpd);
---
{size === 'inline' ? (
  <div class:list={['facts', className]}>
    {L.published ? (
      <>
        {rpm ? <span><span class="num">{rpm}</span> RPM</span> : <span class="muted">RPM not published</span>}
        <span class="sep" aria-hidden="true">·</span>
        {rpd ? <span><span class="num">{rpd}</span> RPD</span> : <span class="muted">RPD not published</span>}
      </>
    ) : <span class="muted">Limits not published</span>}
    <span class="sep" aria-hidden="true">·</span>
    <span><span class="num">{formatCount(models)}</span> {models === 1 ? 'model' : 'models'}</span>
    {ctx && <><span class="sep" aria-hidden="true">·</span><span><span class="num" title={ctx.title}>{ctx.text}</span> context</span></>}
  </div>
) : (
  <div class:list={['lf', size === 'large' ? 'lf-lg' : 'lf-c', className]}>
    {L.published ? (
      <>
        <div><span class="lf-l">Requests/min</span><span class="lf-v">{rpm ? <span class="num">{rpm}</span> : <NotPublished note={L.note} />}</span></div>
        <div><span class="lf-l">Requests/day</span><span class="lf-v">{rpd ? <span class="num">{rpd}</span> : <NotPublished note={L.note} />}</span></div>
      </>
    ) : (
      <div class="span2"><span class="lf-l">Request limits</span><span class="lf-v"><NotPublished note={L.note} label={size === 'large' ? 'Not published by the provider' : 'Not published · see provider terms'} /></span></div>
    )}
    <div><span class="lf-l">Max context</span><span class="lf-v">{ctx ? <span class="num" title={ctx.title}>{ctx.text}</span> : <NotPublished note={NO_CONTEXT_NOTE} />}</span></div>
    {size === 'large' && <div><span class="lf-l">Free models</span><span class="lf-v"><span class="num">{formatCount(models)}</span></span></div>}
  </div>
)}
