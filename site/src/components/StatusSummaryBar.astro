---
interface Props {
  summary: {
    active: number;
    degraded: number;
    dead: number;
    unknown?: number;
    total?: number;
    last_checked: string | null;
  };
}

const { summary } = Astro.props;

function formatTime(isoString: string | null): string {
  if (!isoString) return 'not yet available';
  const date = new Date(isoString);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffMins = Math.floor(diffMs / 60000);
  const diffHours = Math.floor(diffMins / 60);

  if (diffMins < 1) return 'just now';
  if (diffMins < 60) return `${diffMins}m ago`;
  if (diffHours < 24) return `${diffHours}h ago`;
  return date.toLocaleDateString('en-US');
}

const lastChecked = formatTime(summary.last_checked);

// Definitions mirror both checkers: the legacy one probes one test model per
// provider, the per-model (D1) one summarizes recently sampled models and never
// reports "down". Anything that is not a real health signal is "unknown".
const statusItems = [
  { key: 'active', label: 'operational', title: 'Operational', count: summary.active, dot: 'bg-green-500 animate-pulse', text: 'text-green-400', hidden: false,
    lines: ['Recently checked models returned a valid completion.'] },
  { key: 'degraded', label: 'degraded', title: 'Degraded', count: summary.degraded, dot: 'bg-yellow-500', text: 'text-yellow-400', hidden: false,
    lines: ['HTTP 503 / 529 or a timeout.', 'Per-model checks also count any HTTP 5xx, network errors, or a mix of healthy and failing models here.'] },
  { key: 'dead', label: 'down', title: 'Down', count: summary.dead, dot: 'bg-red-500', text: 'text-red-400', hidden: false,
    lines: ['Other HTTP 5xx, unexpected responses, or network failures on the provider-level check.', 'Applies to the checked models and monitoring account only.'] },
  { key: 'unknown', label: 'unknown', title: 'Unknown', count: summary.unknown ?? 0, dot: 'bg-gray-500', text: 'text-gray-400', hidden: (summary.unknown ?? 0) === 0,
    lines: ['Auth or quota errors (HTTP 401 / 402 / 403 / 429), other 4xx such as 404, an invalid completion, not checked yet, or the last result is older than the freshness window.'] },
];
---

<div
  id="status-summary-bar"
  class="bg-slate-800/50 border-b border-slate-700/50 py-3"
>
  <div class="relative max-w-7xl mx-auto px-4 md:px-6 lg:px-8 flex flex-wrap items-center gap-4 md:gap-6 text-sm font-mono">
    {statusItems.map(item => (
      <div
        id={item.key === 'unknown' ? 'unknown-block' : undefined}
        class={`status-tip sm:relative group flex items-center ${item.hidden ? 'hidden' : ''}`}
      >
        <span
          tabindex="0"
          aria-describedby={`status-tip-${item.key}`}
          class="flex items-center gap-1.5 cursor-default rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400"
        >
          <span class={`w-2 h-2 rounded-full inline-block ${item.dot}`} aria-hidden="true"></span>
          <span id={`count-${item.key}`} class={`font-semibold ${item.text}`}>{item.count}</span>
          <span class="text-slate-400 text-xs">{item.label}</span>
        </span>
        <div
          id={`status-tip-${item.key}`}
          role="tooltip"
          class="status-tip-panel absolute top-full left-4 right-4 sm:left-0 sm:right-auto mt-2 hidden group-hover:block group-focus-within:block z-50 pointer-events-none sm:w-64"
        >
          <div class="bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-300 shadow-xl whitespace-normal">
            <p class={`font-semibold mb-1 ${item.text}`}>{item.title}</p>
            {item.lines.map(line => <p class="text-slate-300">{line}</p>)}
          </div>
        </div>
      </div>
    ))}
    <div class="ml-auto flex items-center gap-2 text-slate-400 text-xs">
      <span id="last-checked-label">Last checked: {lastChecked}</span>
      <button
        type="button"
        id="refresh-btn"
        class="flex items-center gap-1 text-slate-400 hover:text-slate-200 transition-colors duration-150 cursor-pointer"
        title="Refresh"
      >
        <svg aria-hidden="true" id="refresh-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hover:rotate-12 transition-transform duration-150">
          <polyline points="23 4 23 10 17 10"></polyline>
          <polyline points="1 20 1 14 7 14"></polyline>
          <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
        </svg>
        Refresh
      </button>
    </div>
  </div>
</div>

<script>
  import { onStatus } from '../lib/status-client';
  onStatus(data => {
    for (const status of ['active', 'degraded', 'dead', 'unknown'] as const) {
      const el = document.getElementById(`count-${status}`);
      if (el) el.textContent = String(data[status]);
    }
    document.getElementById('unknown-block')?.classList.toggle('hidden', data.unknown === 0);
  });

  // Tooltips open on hover and keyboard focus; Escape dismisses the open one
  // without moving focus (WAI-ARIA tooltip pattern).
  document.querySelectorAll<HTMLElement>('.status-tip').forEach(tip => {
    const panel = tip.querySelector<HTMLElement>('.status-tip-panel');
    const reset = () => { if (panel) panel.style.display = ''; };
    tip.addEventListener('keydown', event => { if (event.key === 'Escape' && panel) panel.style.display = 'none'; });
    tip.addEventListener('focusout', reset);
    tip.addEventListener('mouseleave', reset);
  });
</script>
