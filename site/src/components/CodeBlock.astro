---
// Code block: surface frame, header with language label (left) and Wrap / Copy on the right,
// code on --bg-base. No traffic-light dots. Comment lines (# or //) are muted.
// wrap: "auto" (default) = wrapped below 640px, unwrapped above; true/false forces the initial state.
// foldLines: collapse to N lines with a fade and a "Show full file (N lines)" button.
// To change the code from a script, call setCodeBlock(id, code) from ./ui (keeps folding and copy in sync).
import Icon from './Icon.astro';
interface Props {
  code: string;
  language?: string;
  /** Header label; defaults to the language. */
  title?: string;
  /** Id of the <code> element (default: generated). */
  id?: string;
  wrap?: boolean | 'auto';
  foldLines?: number;
  class?: string;
}
const { code, language = 'bash', title, wrap = 'auto', foldLines, class: className } = Astro.props;
const id = Astro.props.id ?? `code-${Math.random().toString(36).slice(2, 9)}`;
const lines = code.split('\n');
const segments = lines.map((line, i) => ({ text: line + (i < lines.length - 1 ? '\n' : ''), comment: /^\s*(#|\/\/)/.test(line) }));
const foldable = !!foldLines && lines.length > foldLines;
---
<div
  class:list={['code', { wrapped: wrap === true, 'code-fold': !!foldLines, folded: foldable }, className]}
  data-code-block
  data-wrap={wrap === 'auto' ? 'auto' : undefined}
  data-fold-lines={foldLines}
  style={foldLines ? `--fold-lines: ${foldLines}` : undefined}
>
  <div class="code-h">
    <span class="lang">{title || language}</span>
    <button type="button" class="btn btn-t btn-sm" data-wrap-toggle aria-pressed={wrap === true ? 'true' : 'false'}>Wrap</button>
    <button type="button" class="btn btn-t btn-sm" data-copy-from={id} aria-label={`Copy ${title || language} code`}><Icon name="copy" size={13} /> Copy</button>
  </div>
  <div class="code-body">
    <pre tabindex="0" aria-label={`${title || language} code`}><code id={id}>{segments.map(s => s.comment ? <span class="c">{s.text}</span> : s.text)}</code></pre>
  </div>
  {foldLines && (
    <div class="code-more" hidden={!foldable}>
      <button type="button" class="btn btn-sm" data-fold-toggle aria-expanded="false">Show full file ({lines.length} lines)</button>
    </div>
  )}
</div>
